// Every pushed reminder from every teacher, so an admin can clean up
// or correct anything school-wide. Self-reminders are excluded.
function adminGetAllSentReminders() {
  try {
    var u = getCurrentUser();
    if (u.realRole !== 'teacher') return {success: false, error: 'Not authorized', reminders: []};
    var sheet = getSheet('Reminders');
    if (!sheet) return {success: true, reminders: []};
    var data = sheet.getDataRange().getValues();

    var users = getSheet('Users');
    var nameMap = {};
    if (users) {
      var uData = users.getDataRange().getValues();
      for (var k = 1; k < uData.length; k++) nameMap[String(uData[k][0])] = String(uData[k][1] || '');
    }

    var out = [];
    for (var i = 1; i < data.length; i++) {
      if (!data[i][0]) continue;
      var src = String(data[i][3] || '');
      if (src !== 'admin' && src !== 'teacher') continue;
      var by = String(data[i][1] || '');
      out.push({
        id: String(data[i][0]),
        createdBy: by,
        createdByName: nameMap[by] || by,
        assignedTo: String(data[i][2] || ''),
        source: src,
        title: String(data[i][4] || ''),
        body: String(data[i][5] || ''),
        triggerAt: data[i][6] ? new Date(data[i][6]).toISOString() : '',
        createdAt: data[i][10] ? new Date(data[i][10]).toISOString() : ''
      });
    }
    out.sort(function(a, b) {
      return new Date(b.createdAt || 0).getTime() - new Date(a.createdAt || 0).getTime();
    });
    return {success: true, reminders: out};
  } catch(e) {
    return {success: false, error: e.toString(), reminders: []};
  }
}

function adminUpdateReminder(id, title, body, triggerAt) {
  try {
    var u = getCurrentUser();
    if (u.realRole !== 'teacher') return {success: false, error: 'Not authorized'};
