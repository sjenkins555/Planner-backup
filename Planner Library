// ─── HELPERS (private) ───────────────────────────────────────
function _getRowBalance(email) {
  var sheet = getSheet('RowAccounts');
  if (!sheet) return 0;
  var data = sheet.getDataRange().getValues();
  for (var i = 1; i < data.length; i++) {
    if (data[i][0] === email) return Number(data[i][1]) || 0;
  }
  return 0;
}

// Atomically add to a balance. Parallel callers (Approve All fires every
// approval at once) were each reading the same starting value and writing
// the same result, so two approvals could land as one ROW.
function _addRowBalance(email, delta) {
  var lock = LockService.getScriptLock();
  lock.waitLock(20000);
  try {
    var newBal = Math.max(0, _getRowBalance(email) + delta);
    _setRowBalance(email, newBal);
    return newBal;
  } finally {
    lock.releaseLock();
  }
}

function _setRowBalance(email, newBal) {
  var sheet = getSheet('RowAccounts');
  if (!sheet) return false;
  var data = sheet.getDataRange().getValues();
  var ts = new Date().toISOString();
  for (var i = 1; i < data.length; i++) {
    if (data[i][0] === email) {
      sheet.getRange(i+1, 2).setValue(newBal);
      sheet.getRange(i+1, 3).setValue(ts);
      return true;
    }
  }
  sheet.appendRow([email, newBal, ts]);
  return true;
}

