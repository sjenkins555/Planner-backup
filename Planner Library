function _myGroupNamesForReminders(email) {
  try {
    var groups = getGroups();
    return groups
      .filter(function(g) { return g.emails.indexOf(email) > -1; })
      .map(function(g) { return g.name; });
  } catch(e) { return []; }
}

function _isAssignedToMe(assignedTo, email, myGroupNames) {
  if (!assignedTo) return false;
  if (assignedTo === 'all') return true;
  if (assignedTo === email) return true;
  if (myGroupNames.indexOf(assignedTo) > -1) return true;
  return false;
}

function getMyReminders() {
  try {
    var u = getCurrentUser();
    if (u.error) return {success: false, reminders: []};
    var sheet = getSheet('Reminders');
    if (!sheet) return {success: true, reminders: []};
    var data = sheet.getDataRange().getValues();
    var myGroups = _myGroupNamesForReminders(u.email);
    var now = new Date();
    var out = [];
    for (var i = 1; i < data.length; i++) {
      if (!data[i][0]) continue;
      var assignedTo = String(data[i][2] || '');
      if (!_isAssignedToMe(assignedTo, u.email, myGroups)) continue;
      var dismissed = [];
      try { dismissed = JSON.parse(data[i][9] || '[]'); } catch(e) {}
      if (dismissed.indexOf(u.email) > -1) continue;
      var triggerAt = data[i][6];
      var tDate = null;
      if (triggerAt) {
        tDate = triggerAt instanceof Date ? triggerAt : new Date(triggerAt);
        if (isNaN(tDate)) tDate = null;
      }
      var isRipe = !tDate || tDate <= now;
      out.push({
        id: String(data[i][0]),
        createdBy: String(data[i][1] || ''),
        assignedTo: assignedTo,
        source: String(data[i][3] || 'student'),
        title: String(data[i][4] || ''),
        body: String(data[i][5] || ''),
        triggerAt: tDate ? tDate.toISOString() : '',
        linkedTaskId: String(data[i][7] || ''),
        subject: String(data[i][8] || ''),
        createdAt: data[i][10] ? new Date(data[i][10]).toISOString() : '',
        isMine: String(data[i][1] || '') === u.email,
        isRipe: isRipe
      });
    }
    out.sort(function(a, b) {
      if (a.isRipe && !b.isRipe) return -1;
      if (!a.isRipe && b.isRipe) return 1;
      var aT = a.triggerAt ? new Date(a.triggerAt).getTime() : 0;
      var bT = b.triggerAt ? new Date(b.triggerAt).getTime() : 0;
      if (a.isRipe) return bT - aT;
      return aT - bT;
    });
    return {success: true, reminders: out};
  } catch(e) {
    return {success: false, error: e.toString(), reminders: []};
  }
}

