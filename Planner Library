function getEmbeddedDocsForStudent(email) {
  var sheet = getSheet('EmbeddedDocs');
  if (!sheet) return [];
  var allGroups = getGroups();
  var myGroupNames = allGroups
    .filter(function(g) { return g.emails.indexOf(email) > -1; })
    .map(function(g) { return g.name; });
  var data = sheet.getDataRange().getValues();
  var seen = {}, docs = [];
  for (var i = 1; i < data.length; i++) {
    var assignedTo = String(data[i][1] || '');
    var id = String(data[i][0] || '');
    if (!id) continue;
    if (assignedTo === 'all' || assignedTo === email || myGroupNames.indexOf(assignedTo) > -1) {
      if (!seen[id]) {
        seen[id] = true;
        docs.push({
          id: id,
          title: String(data[i][2] || 'Untitled'),
          url: String(data[i][3] || ''),
          docType: String(data[i][4] || 'doc'),
          assignedTo: assignedTo,
          assignedBy: String(data[i][5] || '')
        });
      }
    }
  }
  return docs;
}

