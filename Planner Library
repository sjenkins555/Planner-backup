function approveRowRequest(requestId, amount, comment) {
  try {
    var u = getCurrentUser();
    if (u.realRole !== 'teacher') return {success: false, error: 'Not authorized'};
    var amt = parseInt(amount, 10);
    if (isNaN(amt) || amt < 1 || amt > 10) {
      return {success: false, error: 'Amount must be 1–10.'};
    }
    var sheet = getSheet('RowTransactions');
    if (!sheet) return {success: false};

    // Hold the lock across the whole find-mark-credit sequence. Without it,
    // two calls for the same request (double-click, two open tabs, Approve
    // All firing in parallel) can both see it as pending and both credit.
    var lock = LockService.getScriptLock();
    lock.waitLock(20000);
    try {
      var data = sheet.getDataRange().getValues();
      for (var i = 1; i < data.length; i++) {
        if (String(data[i][0]) === String(requestId)
            && String(data[i][2]) === u.email
            && String(data[i][7]) === 'pending') {
          var studentEmail = String(data[i][1]);
          sheet.getRange(i + 1, 5).setValue(amt);
          sheet.getRange(i + 1, 8).setValue('approved');
          sheet.getRange(i + 1, 10).setValue(new Date().toISOString());
          sheet.getRange(i + 1, 11).setValue(String(comment || ''));
          SpreadsheetApp.flush();          // commit "approved" before the lock releases
          var newBal = _addRowBalance(studentEmail, amt);
          return {success: true, newBalance: newBal};
        }
      }
      return {success: false, error: 'Request not found or already resolved.'};
    } finally {
      lock.releaseLock();
    }
  } catch(e) {
    return {success: false, error: e.toString()};
  }
}

