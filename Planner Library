// ─── GRADING PERIODS (school-wide date ranges, stored in Config) ───
// One Config row, GRADING_PERIODS, holding a JSON array of
// {id, name, start, end}. Read by any report that needs a date range.
function getGradingPeriods() {
  try {
    var sheet = getSheet('Config');
    if (!sheet) return {success: true, periods: []};
    var data = sheet.getDataRange().getValues();
    for (var i = 0; i < data.length; i++) {
      if (String(data[i][0]) === 'GRADING_PERIODS') {
        var raw = String(data[i][1] || '');
        if (!raw) return {success: true, periods: []};
        try { return {success: true, periods: JSON.parse(raw)}; }
        catch(e) { return {success: true, periods: []}; }
      }
    }
    return {success: true, periods: []};
  } catch(e) {
    return {success: false, error: e.toString(), periods: []};
  }
}

function setGradingPeriods(periodsJson) {
  try {
    var u = getCurrentUser();
    if (u.realRole !== 'teacher') return {success: false, error: 'Not authorized'};

    var parsed;
    try { parsed = JSON.parse(periodsJson); }
    catch(e) { return {success: false, error: 'Could not read the periods.'}; }
    if (!Array.isArray(parsed)) return {success: false, error: 'Could not read the periods.'};

    for (var i = 0; i < parsed.length; i++) {
      var p = parsed[i];
      var nm = String(p.name || '').trim();
      if (!nm) return {success: false, error: 'Every period needs a name.'};
      if (!/^\d{4}-\d{2}-\d{2}$/.test(String(p.start || ''))) return {success: false, error: 'Pick a start date for "' + nm + '".'};
      if (!/^\d{4}-\d{2}-\d{2}$/.test(String(p.end   || ''))) return {success: false, error: 'Pick an end date for "' + nm + '".'};
      if (String(p.end) < String(p.start)) return {success: false, error: '"' + nm + '" ends before it starts.'};
    }

    var clean = parsed.map(function(p, i) {
      return {
        id:    String(p.id || ('gp-' + Date.now() + '-' + i)),
        name:  String(p.name).trim(),
        start: String(p.start),
        end:   String(p.end)
      };
    });
    clean.sort(function(a, b) { return a.start.localeCompare(b.start); });

    var sheet = getSheet('Config');
    if (!sheet) return {success: false, error: 'Config sheet missing'};
    var val = JSON.stringify(clean);
    var data = sheet.getDataRange().getValues();
    for (var i = 0; i < data.length; i++) {
      if (String(data[i][0]) === 'GRADING_PERIODS') {
        sheet.getRange(i + 1, 2).setValue(val);
        return {success: true, periods: clean};
      }
    }
    sheet.appendRow(['GRADING_PERIODS', val]);
    return {success: true, periods: clean};
  } catch(e) {
    return {success: false, error: e.toString()};
  }
}

// ─── ROW REPORTS ─────────────────────────────────────────────
// One pass over RowTransactions, aggregated server-side so the browser
// gets a few KB instead of the whole sheet. Dates are YYYY-MM-DD,
// inclusive on both ends. A ROW counts on the day it was approved or
// awarded, not requested.

// Grade from the graduation year in the email (jdoe32@ = class of 2032),
// with the school year flipping in August.
function _reportGradeOf(email) {
  var local = String(email || '').split('@')[0];
  var m = local.match(/(\d{2})$/);
  if (!m) return null;
  var gradYear = 2000 + parseInt(m[1], 10);
  var now = new Date();
  var yearEnd = now.getMonth() >= 7 ? now.getFullYear() + 1 : now.getFullYear();
  var grade = 12 - (gradYear - yearEnd);
  return (grade >= 1 && grade <= 12) ? grade : null;
}

function getRowReport(startDate, endDate) {
  try {
    var u = getCurrentUser();
    if (u.realRole !== 'teacher') return {success: false, error: 'Not authorized'};

    var start = String(startDate || '');
    var end   = String(endDate   || '');
    if (!/^\d{4}-\d{2}-\d{2}$/.test(start) || !/^\d{4}-\d{2}-\d{2}$/.test(end)) {
      return {success: false, error: 'Bad date range.'};
    }

    // ── Roster + balances ──
    var users = getSheet('Users');
    if (!users) return {success: false, error: 'Users sheet missing'};
    var uData = users.getDataRange().getValues();

    var nameMap = {}, roleMap = {};
    var studentList = [];
    for (var i = 1; i < uData.length; i++) {
      var em = String(uData[i][0] || '');
      if (!em) continue;
      nameMap[em] = String(uData[i][1] || em);
      roleMap[em] = String(uData[i][2] || '');
      if (roleMap[em] === 'student') {
        studentList.push({email: em, name: nameMap[em], grade: _reportGradeOf(em)});
      }
    }

    var balMap = {};
    var accSheet = getSheet('RowAccounts');
    if (accSheet) {
      var aData = accSheet.getDataRange().getValues();
      for (var i = 1; i < aData.length; i++) balMap[String(aData[i][0])] = Number(aData[i][1]) || 0;
    }

    // ── Single pass over transactions ──
    var byTeacher = {}, byStudent = {}, byGrade = {};
    var totals = {earned: 0, spent: 0, adjust: 0, count: 0, pending: 0};

    var tx = getSheet('RowTransactions');
    var data = tx ? tx.getDataRange().getValues() : [];

    for (var i = 1; i < data.length; i++) {
      if (!data[i][0]) continue;
      var studentEmail = String(data[i][1] || '');
      var teacherEmail = String(data[i][2] || '');
      var type         = String(data[i][3] || '');
      var amount       = Number(data[i][4]) || 0;
      var status       = String(data[i][7] || '');

      // Date the ROW actually landed
      var when = data[i][9] || data[i][8];
      if (!when) continue;
      var d = String(new Date(when).toISOString()).slice(0, 10);
      if (d < start || d > end) continue;

      if (status === 'pending') { totals.pending++; continue; }
      if (status === 'denied') continue;

      var isCredit = (type === 'award') || (type === 'request' && status === 'approved') || (type === 'admin_credit');
      var isSpend  = (type === 'spend');
      var isDebit  = (type === 'admin_debit');
      if (!isCredit && !isSpend && !isDebit) continue;

      if (!byStudent[studentEmail]) byStudent[studentEmail] = {earned: 0, spent: 0, adjust: 0};

      if (isCredit) {
        totals.earned += amount;
        totals.count++;
        byStudent[studentEmail].earned += amount;
        if (type === 'admin_credit') byStudent[studentEmail].adjust += amount;

        if (teacherEmail) {
          if (!byTeacher[teacherEmail]) byTeacher[teacherEmail] = {approved: 0, awarded: 0, total: 0, students: {}};
          if (type === 'request') byTeacher[teacherEmail].approved += amount;
          else                     byTeacher[teacherEmail].awarded  += amount;
          byTeacher[teacherEmail].total += amount;
          byTeacher[teacherEmail].students[studentEmail] = true;
        }

        var g = _reportGradeOf(studentEmail);
        var gk = g ? String(g) : 'other';
        if (!byGrade[gk]) byGrade[gk] = {rows: 0, students: {}};
        byGrade[gk].rows += amount;
        byGrade[gk].students[studentEmail] = true;
      } else if (isSpend) {
        totals.spent += amount;
        byStudent[studentEmail].spent += amount;
      } else {
        totals.adjust -= amount;
        byStudent[studentEmail].adjust -= amount;
      }
    }

    // ── Shape the output ──
    var teachers = Object.keys(byTeacher).map(function(em) {
      return {
        email: em,
        name: nameMap[em] || em,
        approved: byTeacher[em].approved,
        awarded: byTeacher[em].awarded,
        total: byTeacher[em].total,
        studentsReached: Object.keys(byTeacher[em].students).length
      };
    });
    // Staff who gave nothing in range still belong in the report
    for (var em in roleMap) {
      if (roleMap[em] === 'teacher' && !byTeacher[em]) {
        teachers.push({email: em, name: nameMap[em] || em, approved: 0, awarded: 0, total: 0, studentsReached: 0});
      }
    }
    teachers.sort(function(a, b) { return b.total - a.total || a.name.localeCompare(b.name); });

    var grades = ['6','7','8','other'].filter(function(k) { return byGrade[k]; }).map(function(k) {
      var inGrade = studentList.filter(function(s) { return (s.grade ? String(s.grade) : 'other') === k; });
      var reached = Object.keys(byGrade[k].students).length;
      return {
        grade: k,
        rows: byGrade[k].rows,
        studentsWithRows: reached,
        studentsTotal: inGrade.length,
        studentsWithNone: Math.max(0, inGrade.length - reached)
      };
    });

    var students = studentList.map(function(s) {
      var b = byStudent[s.email] || {earned: 0, spent: 0, adjust: 0};
      var current = balMap[s.email] || 0;
      var expected = b.earned - b.spent;
      return {
        email: s.email,
        name: s.name,
        grade: s.grade,
        earned: b.earned,
        spent: b.spent,
        adjust: b.adjust,
        current: current,
        mismatch: (expected !== current)
      };
    });
    students.sort(function(a, b) { return a.earned - b.earned || a.name.localeCompare(b.name); });

    return {
      success: true,
      range: {start: start, end: end},
      totals: {
        earned: totals.earned,
        spent: totals.spent,
        adjust: totals.adjust,
        awards: totals.count,
        pending: totals.pending,
        studentsTotal: studentList.length,
        studentsWithNone: students.filter(function(s) { return s.earned === 0; }).length
      },
      teachers: teachers,
      grades: grades,
      students: students,
      generatedAt: new Date().toISOString()
    };
  } catch(e) {
    return {success: false, error: e.toString()};
  }
}

// ─── LUNCH IMPORT v2 ─────────────────────────────────────────
// Handles the real PDF layout: the day number sits on its own line,
// items follow beneath it, and there's no "Milk" terminator. Days with
// no school collapse onto one line ("3 4 5 6 7") — the last number on
// such a line owns whatever items come next.

function _parseLunchText(rawText) {
  var MONTHS = ['january','february','march','april','may','june',
                'july','august','september','october','november','december'];

  var lines = String(rawText).split(/\r?\n/)
    .map(function(s){ return s.replace(/\s+/g,' ').trim(); })
    .filter(Boolean);

  var month = -1, year = 0;
  var days = [], current = null;

  for (var i = 0; i < lines.length; i++) {
    var line = lines[i];

    // Month/year header, e.g. "August 2026"
    var mh = line.match(/^([A-Za-z]+)\s+(\d{4})$/);
    if (mh) {
      var mi = MONTHS.indexOf(mh[1].toLowerCase());
      if (mi > -1) { month = mi; year = parseInt(mh[2], 10); continue; }
    }

    // Boilerplate
    if (/lunch menu$/i.test(line)) continue;
    if (/^MONDAY\b/i.test(line) && /FRIDAY/i.test(line)) continue;
    if (/subject to change/i.test(line)) continue;
    if (/milk choice/i.test(line)) continue;
    if (/chef salad|PB&J|alternative to the hot lunch/i.test(line)) continue;
    if (/^milk$/i.test(line)) continue;

    // A line of nothing but numbers = day markers. Earlier numbers are
    // days with no menu; the last one starts the day being described.
    if (/^\d{1,2}(\s+\d{1,2})*$/.test(line)) {
      var nums = line.split(/\s+/).map(Number).filter(function(n){ return n >= 1 && n <= 31; });
      if (!nums.length) continue;
      if (current && current.items.length) days.push(current);
      current = {day: nums[nums.length - 1], items: []};
      continue;
    }

    // Anything else is a menu item for the current day
    if (current) current.items.push(line);
  }
  if (current && current.items.length) days.push(current);

  if (!days.length) {
    return {error: 'No menu days found. Each day should have its number on its own line, with the food items on the lines below it.'};
  }
  if (month < 0) {
    return {error: 'Could not find the month. Make sure a line like "August 2026" is included in what you paste.'};
  }
  return {month: month, year: year, days: days};
}

function importLunchData(rawText) {
  var u = getCurrentUser();
  if (u.realRole !== 'teacher') return {success: false, error: 'Not authorized'};
  if (!rawText || typeof rawText !== 'string') return {success: false, error: 'No text provided'};

  var sheet = getSheet('LunchMenu');
  if (!sheet) return {success: false, error: 'LunchMenu sheet missing — run Repair Sheets.'};

  var parsed = _parseLunchText(rawText);
  if (parsed.error) return {success: false, error: parsed.error};

  // Drop menu data older than 60 days so the sheet doesn't grow forever
  try {
    var cutoff = new Date();
    cutoff.setDate(cutoff.getDate() - 60);
    var allData = sheet.getDataRange().getValues();
    for (var r = allData.length - 1; r >= 1; r--) {
      var dv = allData[r][0];
      if (!dv) continue;
      var dd = dv instanceof Date ? dv : new Date(dv);
      if (!isNaN(dd) && dd < cutoff) sheet.deleteRow(r + 1);
    }
  } catch(e) {}

  // Which dates already exist?
  var existing = {};
  try {
    var cur = sheet.getDataRange().getValues();
    for (var i = 1; i < cur.length; i++) {
      var v = cur[i][0];
      if (!v) continue;
      var s = (v instanceof Date)
        ? Utilities.formatDate(v, Session.getScriptTimeZone(), 'yyyy-MM-dd')
        : String(v).slice(0, 10);
      existing[s] = true;
    }
  } catch(e) {}

  var added = 0, skipped = 0, errors = [];
  var MN = ['January','February','March','April','May','June',
            'July','August','September','October','November','December'];

  parsed.days.forEach(function(d) {
    var dateStr = parsed.year + '-' + String(parsed.month + 1).padStart(2,'0') + '-' + String(d.day).padStart(2,'0');
    if (existing[dateStr]) { skipped++; return; }
    if (!d.items.length) { return; }

    // First item is the main; the next four fill the side/veg columns;
    // anything beyond that gets folded into notes.
    var items = d.items.slice();
    var main  = items.shift();
    var s1 = items.shift() || '';
    var s2 = items.shift() || '';
    var s3 = items.shift() || '';
    var vg = items.shift() || '';
    var notes = items.join(', ');

    try {
      sheet.appendRow([dateStr, main, s1, s2, s3, vg, notes]);
      existing[dateStr] = true;
      added++;
    } catch(e) {
      errors.push('Day ' + d.day + ': ' + e.toString());
    }
  });

  return {
    success: true,
    added: added,
    skipped: skipped,
    errors: errors,
    targetMonth: MN[parsed.month] + ' ' + parsed.year
  };
}

