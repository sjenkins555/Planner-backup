// ─── ROW ADMIN: single-student detail ────────────────────────
// Does a transaction move the balance, and which way?
function _rowTxEffect(type, status, amount) {
  var amt = Number(amount) || 0;
  if (status === 'pending' || status === 'denied') return 0;
  if (type === 'award' || type === 'admin_credit') return amt;
  if (type === 'request' && status === 'approved') return amt;
  if (type === 'spend' || type === 'admin_debit') return -amt;
  return 0;
}

function adminGetStudentRowDetail(studentEmail) {
  try {
    var u = getCurrentUser();
    if (u.realRole !== 'teacher') return {success: false, error: 'Not authorized'};
    if (!studentEmail) return {success: false, error: 'No student selected.'};

    var users = getSheet('Users');
    var nameMap = {};
    if (users) {
      var uData = users.getDataRange().getValues();
      for (var k = 1; k < uData.length; k++) nameMap[String(uData[k][0])] = String(uData[k][1] || '');
    }

    var out = [], earned = 0, spent = 0;
    var sheet = getSheet('RowTransactions');
    if (sheet) {
      var data = sheet.getDataRange().getValues();
      for (var i = 1; i < data.length; i++) {
        if (String(data[i][1]) !== studentEmail) continue;
        var type = String(data[i][3] || ''), status = String(data[i][7] || '');
        var amt = Number(data[i][4]) || 0;
        var eff = _rowTxEffect(type, status, amt);
        if (eff > 0) earned += eff; else if (eff < 0) spent += -eff;
        out.push({
          id: String(data[i][0] || ''),
          teacherEmail: String(data[i][2] || ''),
          teacherName: nameMap[String(data[i][2])] || String(data[i][2] || ''),
          type: type,
          amount: amt,
          category: String(data[i][5] || ''),
          description: String(data[i][6] || ''),
          status: status,
          createdAt: data[i][8] ? new Date(data[i][8]).toISOString() : '',
          resolvedAt: data[i][9] ? new Date(data[i][9]).toISOString() : '',
          effect: eff
        });
      }
    }
    out.sort(function(a, b) {
      return new Date(b.resolvedAt || b.createdAt || 0).getTime()
           - new Date(a.resolvedAt || a.createdAt || 0).getTime();
    });

    return {
      success: true,
      email: studentEmail,
      name: nameMap[studentEmail] || studentEmail,
      balance: _getRowBalance(studentEmail),
      earned: earned,
      spent: spent,
      transactions: out
    };
  } catch(e) {
    return {success: false, error: e.toString()};
  }
}

// Delete a transaction and back out whatever it did to the balance.
function adminDeleteRowTransaction(txId) {
  try {
    var u = getCurrentUser();
    if (u.realRole !== 'teacher') return {success: false, error: 'Not authorized'};
    var sheet = getSheet('RowTransactions');
    if (!sheet) return {success: false, error: 'RowTransactions sheet missing'};

    var lock = LockService.getScriptLock();
    lock.waitLock(20000);
    try {
      var data = sheet.getDataRange().getValues();
      for (var i = 1; i < data.length; i++) {
        if (String(data[i][0]) !== String(txId)) continue;
        var studentEmail = String(data[i][1] || '');
        var eff = _rowTxEffect(String(data[i][3]), String(data[i][7]), data[i][4]);
        sheet.deleteRow(i + 1);
        SpreadsheetApp.flush();
        var newBal = eff ? _addRowBalance(studentEmail, -eff) : _getRowBalance(studentEmail);
        return {success: true, newBalance: newBal, reversed: eff};
      }
      return {success: false, error: 'Transaction not found.'};
    } finally {
      lock.releaseLock();
    }
  } catch(e) {
    return {success: false, error: e.toString()};
  }
}

// Set a balance to an exact number, logging the difference for the audit trail.
function adminSetRowBalance(studentEmail, newBalance, reason) {
  try {
    var u = getCurrentUser();
    if (u.realRole !== 'teacher') return {success: false, error: 'Not authorized'};
    var target = parseInt(newBalance, 10);
    if (isNaN(target) || target < 0) return {success: false, error: 'Balance must be zero or more.'};
    if (target > 10000) return {success: false, error: 'That balance is too large.'};
    if (!studentEmail) return {success: false, error: 'No account selected.'};

    var lock = LockService.getScriptLock();
    lock.waitLock(20000);
    try {
      var cur = _getRowBalance(studentEmail);
      var delta = target - cur;
      if (delta === 0) return {success: true, newBalance: cur, delta: 0};
      _setRowBalance(studentEmail, target);

      var txSheet = getSheet('RowTransactions');
      if (txSheet) {
        var now = new Date().toISOString();
        txSheet.appendRow([
          generateId(), studentEmail, u.email,
          delta > 0 ? 'admin_credit' : 'admin_debit',
          Math.abs(delta), 'Manual Adjustment',
          String(reason || ('Balance set to ' + target)),
          'completed', now, now, ''
        ]);
      }
      return {success: true, newBalance: target, delta: delta};
    } finally {
      lock.releaseLock();
    }
  } catch(e) {
    return {success: false, error: e.toString()};
  }
}

