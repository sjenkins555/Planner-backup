// Reject an identical adjustment for the same student within a few seconds.
// Catches double-submits the browser guard missed (two tabs, fast clicks).
function _rowDupeGuard(email, delta) {
  try {
    var cache = CacheService.getScriptCache();
    var key = 'rowadj_' + Utilities.base64EncodeWebSafe(email + '|' + delta);
    if (cache.get(key)) return true;
    cache.put(key, '1', 3);
    return false;
  } catch(e) {
    return false;   // cache trouble shouldn't block a legitimate adjustment
  }
}

function adminAdjustRowBalance(studentEmail, delta, reason) {
  try {
    var u = getCurrentUser();
