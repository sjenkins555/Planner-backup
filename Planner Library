function getMyCalendars() {
  try {
    var cals = [];
    if (typeof Calendar !== 'undefined' && Calendar.CalendarList) {
      var list = Calendar.CalendarList.list({minAccessRole: 'reader', maxResults: 50});
      if (list && list.items) {
        list.items.forEach(function(c) {
          cals.push({
            id: c.id,
            name: c.summary || c.id,
            color: c.backgroundColor || '#6366f1',
            primary: !!c.primary
          });
        });
        cals.sort(function(a, b) { return (b.primary ? 1 : 0) - (a.primary ? 1 : 0); });
        return cals;
      }
    }
    var calApp = CalendarApp.getAllCalendars();
    calApp.forEach(function(c) {
      cals.push({
        id: c.getId(),
        name: c.getName(),
        color: c.getColor() || '#6366f1',
        primary: c.getId() === getEmail()
      });
    });
    cals.sort(function(a, b) { return (b.primary ? 1 : 0) - (a.primary ? 1 : 0); });
    return cals;
  } catch(e) {
    var email = getEmail();
    return [{id: email, name: 'My Calendar', color: '#6366f1', primary: true}];
  }
}

// ─── ROW AWARD (teacher gives ROWs directly, no student request) ───
// Writes a proper category so R/O/W reporting stays clean, unlike
// adminAdjustRowBalance which logs everything as "Manual Adjustment".
function awardRow(studentEmail, amount, category, description) {
  try {
    var u = getCurrentUser();
    if (u.realRole !== 'teacher') return {success: false, error: 'Not authorized'};

    var amt = parseInt(amount, 10);
    if (isNaN(amt) || amt < 1 || amt > 10) return {success: false, error: 'Amount must be 1–10.'};
    if (!studentEmail) return {success: false, error: 'Pick a student.'};
    if (!category)     return {success: false, error: 'Pick a category.'};

    var users = getSheet('Users');
    var okStudent = false;
    var studentName = studentEmail;
    if (users) {
      var uData = users.getDataRange().getValues();
      for (var i = 1; i < uData.length; i++) {
        if (String(uData[i][0]) === studentEmail && String(uData[i][2]) === 'student') {
          okStudent = true;
          studentName = String(uData[i][1] || studentEmail);
          break;
        }
      }
    }
    if (!okStudent) return {success: false, error: 'Student not found.'};

    var txSheet = getSheet('RowTransactions');
    if (!txSheet) return {success: false, error: 'RowTransactions sheet missing — run Repair Sheets.'};

        var newBal = _addRowBalance(studentEmail, amt);

    var now = new Date().toISOString();
    txSheet.appendRow([
      generateId(), studentEmail, u.email, 'award',
      amt, String(category), String(description || ''),
      'approved', now, now, ''
    ]);

    return {success: true, newBalance: newBal, studentName: studentName};
  } catch(e) {
    return {success: false, error: e.toString()};
  }
}

