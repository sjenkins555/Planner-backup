      + '<div style="font-size:14px;font-weight:700;color:' + color + ';min-width:52px;text-align:right;">' + amtStr + '</div>'
      + '<button onclick="aRowDelTx(\'' + esc(t.id) + '\')" title="Delete this transaction" style="padding:4px 9px;background:transparent;color:#f87171;border:1px solid rgba(239,68,68,.4);border-radius:5px;font-size:13px;font-weight:700;cursor:pointer;font-family:inherit;">\u2715</button>'
      + '</div>';
