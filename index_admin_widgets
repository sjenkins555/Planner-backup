// ── ROW REPORTS WIDGET ──────────────────────────────────────────
// Three tabs over one server call. Widget shows a scannable summary;
// Print shows every row under the same filters.
var _aRptTab   = 'students';
var _aRptGrade = 'all';
var _aRptRange = null;
var _aRptData  = null;
var _aRptSortAsc = false;   // false = highest first (default)

function aRptToggleSort(){ _aRptSortAsc = !_aRptSortAsc; aRptRender(); }

// Reports use the email prefix, not the self-chosen display name.
function rptWho(email){ return String(email || '').split('@')[0]; }

function renderARptWidget(){
  var el = document.getElementById('aw-arpt');
  if (!el) return;
  el.style.display = 'flex';
  el.style.flexDirection = 'column';
  el.style.minHeight = '0';

  loadGradingPeriods(function(){
    var ranges = buildDateRanges();
    if (!_aRptRange) _aRptRange = currentGradingPeriod() || ranges[0];

    var opts = ranges.map(function(r){
      return '<option value="' + esc(r.id) + '"' + (r.id === _aRptRange.id ? ' selected' : '') + '>' + esc(r.label) + '</option>';
    }).join('');

    el.innerHTML =
        '<div style="display:flex;gap:6px;margin-bottom:8px;flex-shrink:0;">'
      +   '<select class="fsel" id="arpt-range" onchange="aRptSetRange(this.value)" style="flex:1;font-size:12px;">' + opts + '</select>'
      +   '<button onclick="aRptPrint()" style="padding:6px 12px;background:#475569;color:#fff;border:none;border-radius:6px;font-size:12px;font-weight:600;cursor:pointer;font-family:inherit;">Print</button>'
      + '</div>'
      + uiTabBar([
          {id:'students', label:'Students'},
          {id:'teachers', label:'Staff'},
          {id:'grades',   label:'Grades'}
        ], _aRptTab, 'aRptTab')
      + '<div id="arpt-body" style="flex:1;min-height:0;overflow-y:auto;padding-right:2px;"><div style="color:var(--tx2);font-size:12px;padding:14px;text-align:center;">Loading...</div></div>';

    aRptLoad();
  });
}

function aRptTab(t){ _aRptTab = t; renderARptWidget(); }

function aRptSetRange(id){
  var ranges = buildDateRanges();
  for (var i = 0; i < ranges.length; i++){ if (ranges[i].id === id){ _aRptRange = ranges[i]; break; } }
  _aRptData = null;
  aRptLoad();
}

function aRptGradeSet(g){ _aRptGrade = g; aRptRender(); }

function aRptLoad(){
  var body = document.getElementById('arpt-body');
  if (body) body.innerHTML = '<div style="color:var(--tx2);font-size:12px;padding:14px;text-align:center;">Loading report...</div>';
  google.script.run.withSuccessHandler(function(r){
    if (!r || !r.success){
      if (body) body.innerHTML = '<div style="color:#f87171;font-size:12px;padding:10px;">' + esc((r && r.error) || 'Could not load') + '</div>';
      return;
    }
    _aRptData = r;
    aRptRender();
  }).withFailureHandler(function(e){
    if (body) body.innerHTML = '<div style="color:#f87171;font-size:12px;padding:10px;">' + esc((e && e.message) || 'Server error') + '</div>';
  }).getRowReport(_aRptRange.start, _aRptRange.end);
}

function aRptRender(){
  var body = document.getElementById('arpt-body');
  if (!body || !_aRptData) return;
  var d = _aRptData;

  var summary = '<div style="display:flex;gap:6px;flex-wrap:wrap;margin-bottom:9px;">'
    + '<div style="flex:1;min-width:70px;background:var(--a5);border:1px solid var(--a4);border-radius:7px;padding:6px 9px;">'
    +   '<div style="font-size:17px;font-weight:800;color:var(--a2);line-height:1.1;">' + d.totals.earned + '</div>'
    +   '<div style="font-size:10px;color:var(--tx2);">ROWs given</div></div>'
    + '<div style="flex:1;min-width:70px;background:rgba(239,68,68,.08);border:1px solid rgba(239,68,68,.25);border-radius:7px;padding:6px 9px;">'
    +   '<div style="font-size:17px;font-weight:800;color:#f87171;line-height:1.1;">' + d.totals.studentsWithNone + '</div>'
    +   '<div style="font-size:10px;color:var(--tx2);">with none</div></div>'
    + '<div style="flex:1;min-width:70px;background:rgba(255,255,255,.06);border:1px solid var(--border);border-radius:7px;padding:6px 9px;">'
    +   '<div style="font-size:17px;font-weight:800;color:var(--tx);line-height:1.1;">' + d.totals.studentsTotal + '</div>'
    +   '<div style="font-size:10px;color:var(--tx2);">students</div></div>'
    + '</div>';

  body.innerHTML = summary + (
      _aRptTab === 'teachers' ? aRptTeachersHTML(d, false)
    : _aRptTab === 'grades'   ? aRptGradesHTML(d, false)
    :                           aRptStudentsHTML(d, false)
  );
}

// ── Section builders. print=true drops caps and adds grade headers. ──
function aRptStudentsHTML(d, print){
  // Sort: default high→low, toggled to low→high. Grade groups the print view.
  function sortSeg(arr){
    return arr.slice().sort(function(a, b){
      var diff = _aRptSortAsc ? (a.earned - b.earned) : (b.earned - a.earned);
      return diff || rptWho(a.email).localeCompare(rptWho(b.email));
    });
  }

  function row(s, i){
    var zero = s.earned === 0;
    var shade = (i % 2 === 1) ? 'background:rgba(255,255,255,.045);' : '';
    return '<div class="rpt-row" style="display:flex;align-items:center;gap:10px;padding:6px 10px;border-bottom:1px solid var(--border);' + shade + '">'
      + '<div style="width:34px;text-align:center;font-size:12px;font-weight:600;color:var(--tx2);">' + (s.grade || '\u2014') + '</div>'
      + '<div style="flex:1;min-width:0;font-size:14px;' + (zero ? 'color:#f87171;font-weight:700;' : 'color:var(--tx);font-weight:500;') + 'white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">' + esc(rptWho(s.email)) + '</div>'
      + '<div style="width:52px;text-align:right;font-size:13px;font-weight:700;color:' + (zero ? '#f87171' : 'var(--a2)') + ';">' + s.earned + '</div>'
      + '<div style="width:52px;text-align:right;font-size:12px;color:var(--tx2);">' + s.current + '</div>'
      + '</div>';
  }

  var head = '<div style="display:flex;gap:10px;padding:0 10px 4px;font-size:9px;font-weight:700;letter-spacing:.4px;text-transform:uppercase;color:var(--tx2);border-bottom:2px solid var(--a1);">'
    + '<div style="width:34px;text-align:center;">Gr</div><div style="flex:1;">Student</div>'
    + '<div style="width:52px;text-align:right;">Earned</div><div style="width:52px;text-align:right;">Balance</div></div>';

  if (print){
    var out = '';
    ['6','7','8','other'].forEach(function(g){
      var seg = sortSeg(d.students.filter(function(s){ return String(s.grade || 'other') === g; }));
      if (!seg.length) return;
      var none = seg.filter(function(s){ return s.earned === 0; }).length;
      out += '<h3 class="rpt-h3">' + (g === 'other' ? 'Other' : g + 'th Grade')
        + ' <span style="font-weight:400;font-size:12px;">(' + seg.length + ' students &middot; ' + none + ' with none)</span></h3>'
        + head + seg.map(row).join('');
    });
    return out;
  }

  function gBtn(v, lbl){
    var on = _aRptGrade === v;
    return '<div onclick="aRptGradeSet(\'' + v + '\')" style="flex:1;text-align:center;padding:5px 4px;border-radius:6px;cursor:pointer;font-size:11px;font-weight:600;border:1px solid ' + (on ? 'var(--a1)' : 'var(--border)') + ';background:' + (on ? 'var(--a3)' : 'transparent') + ';color:' + (on ? 'var(--a2)' : 'var(--tx2)') + ';">' + lbl + '</div>';
  }

  var list = sortSeg(d.students.filter(function(s){
    return _aRptGrade === 'all' || String(s.grade || 'other') === _aRptGrade;
  }));
  var shown = list.slice(0, 40);

  return '<div style="display:flex;gap:5px;margin-bottom:6px;">'
    +   gBtn('all','All') + gBtn('6','6th') + gBtn('7','7th') + gBtn('8','8th') + '</div>'
    + '<div style="display:flex;align-items:center;gap:8px;margin-bottom:7px;">'
    +   '<div style="flex:1;font-size:10px;color:var(--tx2);">Red = none this period</div>'
    +   '<button onclick="aRptToggleSort()" style="padding:4px 10px;background:transparent;color:var(--a2);border:1px solid var(--a4);border-radius:6px;font-size:11px;font-weight:600;cursor:pointer;font-family:inherit;">'
    +     (_aRptSortAsc ? 'Lowest first \u2191' : 'Highest first \u2193') + '</button>'
    + '</div>'
    + head + shown.map(row).join('')
    + (list.length > shown.length ? '<div style="font-size:11px;color:var(--tx2);padding:8px;text-align:center;">+' + (list.length - shown.length) + ' more \u2014 use Print for the full list</div>' : '');
}

function aRptTeachersHTML(d, print){
  var head = '<div style="display:flex;gap:10px;padding:0 10px 4px;font-size:9px;font-weight:700;letter-spacing:.4px;text-transform:uppercase;color:var(--tx2);border-bottom:2px solid var(--a1);">'
    + '<div style="flex:1;">Staff</div><div style="width:56px;text-align:right;">Approved</div>'
    + '<div style="width:52px;text-align:right;">Given</div><div style="width:44px;text-align:right;">Total</div>'
    + '<div style="width:58px;text-align:right;">Students</div></div>';

  return head + d.teachers.map(function(t, i){
