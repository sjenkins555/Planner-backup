function aEdCreate(){
  var title = (document.getElementById('aed-title').value || '').trim();
  var url   = (document.getElementById('aed-url').value   || '').trim();
  if (!title || !url){ toast('Title and URL required', 'err'); return; }

  // Detect doc type from URL
  var docType = (typeof detectDocType === 'function') ? detectDocType(url) : 'doc';
  var forced  = !!(document.getElementById('aed-forced') || {}).checked;

  // Resolve target value
  var tv = '';
  if (_aEdTarget === 'grade'){
    tv = (document.getElementById('aeda-grade-val') || {}).value || '';
  } else if (_aEdTarget === 'group'){
    tv = (document.getElementById('aeda-group-val') || {}).value || '';
  } else if (_aEdTarget === 'individual'){
    tv = (document.getElementById('aeda-ind-val') || {}).value || '';
  }

  // Build sheet options if this is a Sheet
  var embedOptions = null;
  if (docType === 'sheet'){
    var gid   = ((document.getElementById('aed-opt-gid')   || {}).value || '').trim();
    var range = ((document.getElementById('aed-opt-range') || {}).value || '').trim();
    var noH   = !!(document.getElementById('aed-opt-noheaders') || {}).checked;
    if (gid || range || noH){
      embedOptions = {};
      if (gid)   embedOptions.gid = gid;
      if (range) embedOptions.range = range;
      if (noH)   embedOptions.hideHeaders = true;
    }
  }

  google.script.run.withSuccessHandler(function(r){
    if (r.success){
      toast('Embedded', 'ok');
      document.getElementById('aed-title').value = '';
      document.getElementById('aed-url').value   = '';
      var f = document.getElementById('aed-forced'); if (f) f.checked = false;
      aEdUrlTypeHint();
    } else {
      toast(r.error || 'Error', 'err');
    }
  }).adminCreateEmbeddedDoc(title, url, docType, _aEdTarget, tv, embedOptions ? JSON.stringify(embedOptions) : '', forced);
}

function aEdLoadList(){
