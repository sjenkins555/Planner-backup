  el.innerHTML =
      '<button onclick="aRowBack()" style="padding:6px 12px;background:transparent;color:var(--a2);border:1px solid var(--a4);border-radius:6px;font-size:12px;font-weight:600;cursor:pointer;font-family:inherit;margin-bottom:10px;">\u2039 All accounts</button>'
    + '<div style="text-align:center;margin-bottom:12px;">'
