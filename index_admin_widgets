// ROW Reward Accounts widget — moved to section 16, near the bottom of this file.

// School-Wide Reminders widget — tabbed (Send New | Sent).
// The Sent tab lists reminders you've sent, with a button to pull each
// one back from everyone's planner.
function renderARemWidget(){
  var el = document.getElementById('aw-arem');
  if (!el) return;

  el.style.display = 'flex';
  el.style.flexDirection = 'column';
  el.style.minHeight = '0';

  var tabBar = uiTabBar([
    {id:'send', label:'Send New'},
    {id:'sent', label:'Sent'}
  ], _aRemTab, 'aRemTab');

  if (_aRemTab === 'sent'){
    el.innerHTML = tabBar + '<div id="arem-sent-list" style="padding:0 4px;"><div style="color:var(--tx3);font-size:12px;padding:12px;text-align:center;">Loading...</div></div>';
    aRemLoadSent();
    return;
  }

  el.innerHTML = tabBar
    + '<div style="font-size:11px;color:var(--tx3);line-height:1.5;margin-bottom:8px;padding:0 4px;">Sends to <strong>every student and teacher</strong>.</div>'
    + '<div style="padding:0 4px;">'
    +   '<input class="finp" id="adm-rem-title" placeholder="\u2014Title *\u2014" style="margin-bottom:6px;" maxlength="100">'
    +   '<textarea class="fta" id="adm-rem-body" placeholder="\u2014Details (optional)\u2014" style="min-height:48px;margin-bottom:6px;" maxlength="300"></textarea>'
    +   '<input type="datetime-local" class="finp" id="adm-rem-when" style="margin-bottom:8px;width:100%;">'
    +   '<button class="btn btn-primary btn-sm" onclick="doSendSchoolReminder()">\u{1F4E3} Send to School</button>'
    +   '<div id="adm-rem-result" style="margin-top:8px;"></div>'
    + '</div>';
}

// Switch tabs on the reminders widget.
function aRemTab(t){ _aRemTab = t; renderARemWidget(); }

// Load reminders this account has PUSHED to other people. Self-reminders
// are excluded — those belong in your own Reminders widget.
// Every pushed reminder in the school, newest first.
function aRemLoadSent(){
  google.script.run.withSuccessHandler(function(r){
    var el = document.getElementById('arem-sent-list');
    if (!el) return;
    if (!r || !r.success){
      el.innerHTML = '<div style="color:#f87171;font-size:12px;padding:10px;">' + esc((r && r.error) || 'Could not load') + '</div>';
      return;
    }
    var list = r.reminders || [];
    if (!list.length){
      el.innerHTML = '<div style="color:var(--tx4);font-size:12px;padding:12px;text-align:center;">No reminders sent yet.</div>';
      return;
    }
    el.innerHTML = '<div style="font-size:10px;color:var(--tx4);margin-bottom:6px;">' + list.length + ' reminder' + (list.length !== 1 ? 's' : '') + ' school-wide</div>'
      + list.map(function(rm){
      var who;
      if (rm.assignedTo === 'all')              who = (rm.source === 'admin') ? 'School-wide' : 'All students';
      else if (rm.assignedTo.indexOf('@') > -1) who = rm.assignedTo.split('@')[0];
      else                                       who = rm.assignedTo;

      var when = '';
      if (rm.triggerAt){
        try {
          when = (typeof fmtDate === 'function') ? fmtDate(rm.triggerAt.slice(0,10)) : rm.triggerAt.slice(0,10);
          if (new Date(rm.triggerAt) > new Date()) when = 'Scheduled ' + when;
        } catch(e){}
      }

      return '<div id="arem-row-' + esc(rm.id) + '" style="background:rgba(15,23,42,.6);border:1px solid var(--border);border-radius:8px;padding:8px 10px;margin-bottom:6px;">'
        + '<div style="font-size:12px;font-weight:600;color:var(--tx);margin-bottom:2px;">' + esc(rm.title) + '</div>'
        + '<div style="font-size:10px;color:var(--tx4);margin-bottom:7px;">' + esc(who) + (when ? ' &middot; ' + esc(when) : '') + ' &middot; by ' + esc(rm.createdByName) + '</div>'
        + '<div style="display:flex;gap:6px;">'
        +   '<button onclick="aRemEdit(\'' + esc(rm.id) + '\')" style="flex:1;padding:5px 8px;background:#475569;color:#fff;border:none;border-radius:6px;font-size:11px;font-weight:600;cursor:pointer;font-family:inherit;">Edit</button>'
        +   '<button onclick="aRemDelete(\'' + esc(rm.id) + '\')" style="flex:1;padding:5px 8px;background:#dc2626;color:#fff;border:none;border-radius:6px;font-size:11px;font-weight:600;cursor:pointer;font-family:inherit;">Remove for everyone</button>'
        + '</div>'
