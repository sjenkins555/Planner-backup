// School-wide date ranges (quarters, trimesters, six-week terms —
// whatever your building uses). Any report can filter by these.
var _aTermDraft = null;

function renderATermWidget(){
  var el = document.getElementById('aw-aterm');
  if (!el) return;
  el.style.display = 'flex';
  el.style.flexDirection = 'column';
  el.style.minHeight = '0';
  el.innerHTML = '<div style="font-size:11px;color:var(--tx2);line-height:1.5;margin-bottom:8px;padding:0 4px;flex-shrink:0;">Set your grading periods once. Reports across the planner use these date ranges.</div>'
    + '<div id="aterm-body" style="flex:1;min-height:0;overflow-y:auto;padding:0 4px;"><div style="color:var(--tx3);font-size:12px;">Loading...</div></div>';

  google.script.run.withSuccessHandler(function(r){
    _aTermDraft = ((r && r.periods) || []).slice();
    if (typeof GRADING_PERIODS !== 'undefined'){ GRADING_PERIODS = _aTermDraft.slice(); _gpLoaded = true; }
