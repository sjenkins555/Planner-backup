// Show a small hint about the URL type + reveal sheet options when it's a Sheet
function aEdUrlTypeHint(){
  var url = (document.getElementById('aed-url') || {}).value || '';
  var hint = document.getElementById('aed-type-hint');
  var opts = document.getElementById('aed-sheet-opts-wrap');
  var isSheet = url.indexOf('/spreadsheets/') > -1;
  if (hint){
    if (!url) hint.textContent = '';
    else if (isSheet) hint.innerHTML = '&#128202; Google Sheet detected — see options below';
    else if (url.indexOf('/document/d/') > -1) hint.innerHTML = '&#128196; Google Doc detected';
    else if (url.indexOf('/presentation/') > -1) hint.innerHTML = '&#128250; Google Slides detected';
    else if (url.indexOf('/forms/d/') > -1) hint.innerHTML = '&#128203; Google Form detected';
    else hint.textContent = 'Unknown URL type — must be a Google doc URL';
  }
