var _rowAdminView   = 'list';
var _rowAdminSel    = '';
var _rowAdminDetail = null;

function renderARowWidget(){
  var el = document.getElementById('aw-arow');
  if (!el) return;
  el.style.display = 'flex';
  el.style.flexDirection = 'column';
  el.style.minHeight = '0';

  if (_rowAdminView === 'detail'){
    el.innerHTML = '<div id="row-admin-detail" style="flex:1;min-height:0;overflow-y:auto;padding-right:2px;"><div style="color:var(--tx2);font-size:13px;padding:14px;text-align:center;">Loading...</div></div>';
    aRowLoadDetail();
    return;
  }

  el.innerHTML =
      '<input class="finp" id="row-admin-search" placeholder="Search students and staff" oninput="aRowRenderList()" style="margin-bottom:8px;font-size:13px;flex-shrink:0;">'
    + '<div id="row-admin-acct-list" style="flex:1;min-height:0;overflow-y:auto;padding-right:2px;"><div style="color:var(--tx2);font-size:13px;padding:14px;text-align:center;">Loading accounts...</div></div>';

  if (_rowAdminAccounts && _rowAdminAccounts.length) aRowRenderList();
  else loadRowAdminAccounts();
}

function loadRowAdminAccounts(){
  google.script.run.withSuccessHandler(function(r){
    if (!r || !r.success){
      var el = document.getElementById('row-admin-acct-list');
      if (el) el.innerHTML = '<div style="color:#f87171;font-size:13px;padding:10px;">' + esc((r && r.error) || 'Error') + '</div>';
      return;
    }
    _rowAdminAccounts = r.accounts || [];
    aRowRenderList();
  }).adminGetAllRowAccounts();
}

function aRowRenderList(){
  var el = document.getElementById('row-admin-acct-list');
  if (!el) return;
  var q = ((document.getElementById('row-admin-search') || {}).value || '').trim().toLowerCase();
  var list = (_rowAdminAccounts || []).filter(function(a){
    if (!q) return true;
    return String(a.name).toLowerCase().indexOf(q) > -1 || String(a.email).toLowerCase().indexOf(q) > -1;
  });

  if (!list.length){
    el.innerHTML = '<div style="color:var(--tx2);font-size:13px;padding:14px;text-align:center;">No matching accounts.</div>';
    return;
  }

    function item(a){
    var who = String(a.email).split('@')[0];
    var rid = _rowIdSafe(a.email);
    var e = esc(a.email);
    function stepBtn(sign, label){
      return '<button onclick="event.stopPropagation();aRowQuick(\'' + e + '\',' + sign + ')" '
        + 'style="width:26px;height:26px;flex:none;padding:0;background:' + (sign > 0 ? '#4f46e5' : '#dc2626') + ';color:#fff;border:none;border-radius:6px;font-size:15px;font-weight:800;line-height:1;cursor:pointer;font-family:inherit;">' + label + '</button>';
    }
    return '<div class="rowadm-item" style="display:flex;align-items:center;gap:7px;background:rgba(255,255,255,.06);border:1px solid var(--border);border-radius:8px;padding:7px 9px;margin-bottom:5px;">'
      + '<div onclick="aRowOpen(\'' + e + '\')" style="flex:1;min-width:0;cursor:pointer;">'
      +   '<div class="rowadm-name" style="font-size:14px;font-weight:600;color:var(--tx);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">' + esc(who) + '</div>'
      +   '<div class="rowadm-sub" style="font-size:11px;color:var(--tx2);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">' + esc(a.name) + (a.role === 'teacher' ? ' \u00b7 Staff' : '') + '</div>'
      + '</div>'
      + stepBtn(-1, '\u2212')
      + '<input id="rowqty-' + rid + '" class="finp" type="number" value="1" min="1" max="100" onclick="event.stopPropagation();" '
      +   'style="width:44px;flex:none;padding:4px 2px;text-align:center;font-size:13px;">'
      + stepBtn(1, '+')
      + '<div id="rowbal-' + rid + '" style="font-size:19px;font-weight:800;color:var(--a2);min-width:38px;text-align:right;">' + a.balance + '</div>'
      + '</div>';
  }

  var students = list.filter(function(a){ return a.role !== 'teacher'; });
  var staff    = list.filter(function(a){ return a.role === 'teacher'; });
  var html = '';
  if (students.length) html += '<div class="rowadm-hdr" style="font-size:10px;font-weight:700;color:var(--tx2);letter-spacing:.5px;text-transform:uppercase;margin:2px 2px 5px;">Students (' + students.length + ')</div>' + students.map(item).join('');
  if (staff.length)    html += '<div class="rowadm-hdr" style="font-size:10px;font-weight:700;color:var(--tx2);letter-spacing:.5px;text-transform:uppercase;margin:12px 2px 5px;padding-top:8px;border-top:1px solid var(--border);">Staff (' + staff.length + ')</div>' + staff.map(item).join('');
  el.innerHTML = html;
}

// One ROW write at a time. Guards every admin balance action against
// double-clicks and button spam — the client-side half of the fix.
var _rowBusy = false;

function _rowLock(){
  if (_rowBusy) return false;
  _rowBusy = true;
  document.querySelectorAll('.rowadm-item button, #row-admin-detail button').forEach(function(b){
    b.disabled = true;
    b.style.opacity = '.5';
    b.style.cursor = 'wait';
  });
  return true;
}

function _rowUnlock(){
  _rowBusy = false;
  document.querySelectorAll('.rowadm-item button, #row-admin-detail button').forEach(function(b){
    b.disabled = false;
    b.style.opacity = '';
    b.style.cursor = '';
  });
}

// Element ids can't contain @ or . — flatten the email for id lookups.
function _rowIdSafe(email){ return String(email).replace(/[^a-zA-Z0-9]/g, '_'); }

// Apply +/- the amount in that row's box, with a spinner while it saves.
function aRowQuick(email, sign){
  var rid = _rowIdSafe(email);
  var qtyEl = document.getElementById('rowqty-' + rid);
  var balEl = document.getElementById('rowbal-' + rid);
  var n = parseInt((qtyEl || {}).value, 10);
  if (isNaN(n) || n < 1){ toast('Enter a number of 1 or more', 'err'); return; }

  if (!_rowLock()) return;          // already saving — ignore the extra click

  var delta = sign * n;
  var prev = balEl ? balEl.innerHTML : '';

  // Swap the number for a spinner and lock the row's buttons
  if (balEl) balEl.innerHTML = '<div class="spinner" style="width:16px;height:16px;border-width:2px;margin:0 0 0 auto;"></div>';
  var btns = balEl ? balEl.parentNode.querySelectorAll('button') : [];
  for (var i = 0; i < btns.length; i++) btns[i].disabled = true;

  function unlock(){ _rowUnlock(); }

  google.script.run.withSuccessHandler(function(r){
    unlock();
    if (r && r.success){
      (_rowAdminAccounts || []).forEach(function(a){ if (a.email === email) a.balance = r.newBalance; });
      if (balEl){
        balEl.innerHTML = r.newBalance;
        // Brief flash so the change is visible
        balEl.style.transition = 'color .1s';
        balEl.style.color = (delta > 0 ? '#22c55e' : '#f87171');
        setTimeout(function(){ balEl.style.color = 'var(--a2)'; }, 700);
      }
      toast((delta > 0 ? '+' : '') + delta + ' ROW \u00b7 now ' + r.newBalance, 'ok');
    } else {
      if (balEl) balEl.innerHTML = prev;
      toast((r && r.error) || 'Could not save', 'err');
    }
  }).withFailureHandler(function(e){
    unlock();
    if (balEl) balEl.innerHTML = prev;
    toast((e && e.message) || 'Server error', 'err');
  }).adminAdjustRowBalance(email, delta, delta > 0 ? 'Admin add' : 'Admin deduct');
}

function aRowOpen(email){ _rowAdminSel = email; _rowAdminView = 'detail'; _rowAdminDetail = null; renderARowWidget(); }
function aRowBack(){ _rowAdminView = 'list'; _rowAdminDetail = null; renderARowWidget(); }

function aRowLoadDetail(){
  google.script.run.withSuccessHandler(function(r){
    var el = document.getElementById('row-admin-detail');
