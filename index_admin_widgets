<script>
/* ═══════════════════════════════════════════════════════════════════
   ║  index_admin_widgets.html — ADMIN TAB CHUNK
   ║  ─────────────────────────────────────────
   ║  Owns the entire Admin tab: 9 widgets in a draggable/resizable grid.
   ║  Only renders for users with realRole === 'teacher' (router enforces this).
   ║
   ║  Widgets (admin tile IDs):
   ║    abell      — Bell Schedules
   ║    aschedcal  — Schedule Calendar (which bells apply on which dates)
   ║    astats     — Spreadsheet Health
   ║    arepair    — Repair Sheets
   ║    alunch     — Lunch Menu Import
   ║    agrad      — Graduate Students
   ║    arow       — ROW Reward Accounts (admin view)
   ║    arem       — School-Wide Reminders
   ║    aclean     — Data Cleanup
   ║
   ║  TABLE OF CONTENTS
   ║  ─────────────────
   ║   1. STATE (caches + UI flags)
   ║   2. PAGE BUILDER (buildAdminPage)
   ║   3. TILE SIZE PICKER (openASzPicker, pickASz)
   ║   4. WIDGET RENDERERS — shell HTML for each of the 9 widgets
   ║   5. SCHOOL-WIDE REMINDERS (doSendSchoolReminder)
   ║   6. SPREADSHEET HEALTH STATS (loadAdminStats)
   ║   7. LUNCH MENU IMPORT (doLunchImport)
   ║   8. REPAIR SHEETS (doRepairSheets)
   ║   9. DATA CLEANUP (doDataCleanup)
   ║  10. BELL SCHEDULES — list + load + delete + set default
   ║  11. BELL SCHEDULES — editor modal (open, period rows, save)
   ║  12. SCHEDULE CALENDAR — month grid + navigation
   ║  13. SCHEDULE CALENDAR — per-date entry modal
   ║  14. SCHEDULE CALENDAR — bulk-assign modal
   ║  15. GRADUATE STUDENTS (load list, select, remove)
   ║  16. ROW REWARDS ADMIN — accounts (load, render, search, adjust)
   ║  17. ROW REWARDS ADMIN — recent transactions
   ║  18. HELPERS (Utilities_format date formatter)
   ═══════════════════════════════════════════════════════════════════ */


/* ═══════════════════════════════════════════════════════════════════
   1. STATE
   These caches let widgets share data without re-fetching across
   re-renders within a single Admin tab session.
   ═══════════════════════════════════════════════════════════════════ */
var _bellSchedulesCache = []; // current bell schedules (refreshed by loadBellSchedules)
var _editingBellId      = null; // which bell is open in the editor modal (null = new)
var _schedCalDate       = null; // first day of currently-shown calendar month
var _gradStudents       = []; // student list for the Graduate widget
var _rowAdminAccounts   = []; // ROW account list for admin search/filter
// Admin Embed Documents widget state
var _aEdTab    = 'add';       // 'add' | 'list'
var _aEdTarget = 'everyone';  // 'everyone' | 'all-students' | 'all-teachers' | 'grade' | 'group' | 'individual'
var _aEdShowOpts = false;     // whether the sheet-options section is expanded
var _aRemTab     = 'send';    // School-Wide Reminders widget: 'send' | 'sent'


/* ═══════════════════════════════════════════════════════════════════
   2. PAGE BUILDER
   Builds the 9-widget grid for the Admin tab. Each tile gets a
   resize gear; ordering and sizes persist via prefs.adminTileOrder
   and prefs.adminTileSizes.
   ═══════════════════════════════════════════════════════════════════ */

// Build the entire Admin tab. Renders an empty grid first, then fires each
// widget's render function in a 50ms setTimeout so the grid paints before
// any async data loads kick in.
function buildAdminPage(){
  // Tile definitions — one per admin widget
  var tileDefs = {
    abell:     {fn:renderABellWidget,     title:'Bell Schedules',         svg:'#w-schedule', defC:2, defR:2},
    aschedcal: {fn:renderASchedCalWidget, title:'Schedule Calendar',      svg:'#w-schedule', defC:4, defR:2},
    astats:    {fn:renderAStatsWidget,    title:'Spreadsheet Health',     svg:'#w-apps',     defC:2, defR:1},
    arepair:   {fn:renderARepairWidget,   title:'Repair Sheets',          svg:'#w-admin',    defC:2, defR:1},
    alunch:    {fn:renderALunchWidget,    title:'Lunch Menu Import',      svg:'#w-embed',    defC:4, defR:2},
    aembed:    {fn:renderAEmbedWidget,    title:'Embedded Documents',     svg:'#w-embed',    defC:3, defR:2},
    agrad:     {fn:renderAGradWidget,     title:'Graduate Students',      svg:'#w-student',  defC:2, defR:2},
    arow:      {fn:renderARowWidget,      title:'ROW Reward Accounts',    svg:'#w-student',  defC:4, defR:2},
    arem:      {fn:renderARemWidget,      title:'School-Wide Reminders',  svg:'#w-timer',    defC:2, defR:2},
    aclean:    {fn:renderACleanWidget,    title:'Data Cleanup',           svg:'#w-admin',    defC:4, defR:2},
    aeggs:     {fn:renderAEggsWidget,     title:'Easter Eggs',            svg:'#w-quote',    defC:2, defR:2},
    aterm:     {fn:renderATermWidget,     title:'Grading Periods',        svg:'#w-schedule', defC:2, defR:3},
    arpt:      {fn:renderARptWidget,      title:'ROW Reports',            svg:'#w-chart',    defC:4, defR:3}
  };

  // Reconcile saved order with the canonical default order:
  // - Drop any tile IDs that no longer exist (older prefs)
  // - Append any new tiles that weren't in the saved order
  var defaultOrder = ['abell','astats','arepair','aschedcal','alunch','aembed','agrad','arow','arem','aclean','aeggs','aterm'];
  if (!prefs.adminTileOrder || !prefs.adminTileOrder.length){
    prefs.adminTileOrder = defaultOrder.slice();
  } else {
    var saved = prefs.adminTileOrder.filter(function(id){ return tileDefs[id]; });
    // Auto-add new widgets, but never re-add ones the user removed on purpose.
    var removed = prefs.adminTileRemoved || [];
    defaultOrder.forEach(function(id){
      if (saved.indexOf(id) === -1 && removed.indexOf(id) === -1) saved.push(id);
    });
    prefs.adminTileOrder = saved;
  }
  if (!prefs.adminTileSizes) prefs.adminTileSizes = {};
  if (!prefs.adminTilePositions) prefs.adminTilePositions = {};

  // Register catalog so the layout editor can list admin widgets in its rail
  window.ADMIN_WIDGETS = Object.keys(tileDefs).map(function(k){ return {id:k, name:tileDefs[k].title}; });
  Object.keys(tileDefs).forEach(function(k){ if (typeof DEF_TILE_SIZES === 'object' && !DEF_TILE_SIZES[k]) DEF_TILE_SIZES[k] = {c:tileDefs[k].defC, r:tileDefs[k].defR}; });

  // Render the panel shell with a Customize Layout button above the grid
  panel('t-admin').innerHTML = '<div style="display:flex;justify-content:flex-end;padding:0 0 12px;"><button class="btn btn-primary btn-sm" onclick="openLayoutEditor(\'admin\')"><svg viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right:4px;vertical-align:-2px;"><circle cx="8" cy="8" r="3"/><path d="M8 1v2M8 13v2M3.5 3.5l1.4 1.4M11.1 11.1l1.4 1.4M1 8h2M13 8h2M3.5 12.5l1.4-1.4M11.1 4.9l1.4-1.4"/></svg>Customize Layout</button></div><div class="tile-grid" id="a-tile-grid" style="grid-auto-rows:minmax(180px,auto);"></div>';

  var grid = document.getElementById('a-tile-grid');
  if (!grid) return;

  // ─── Position handling ────────────────────────────────────────────
  // Auto-assign positions to any widgets that don't have one yet.
  var positions = prefs.adminTilePositions || {};
  var occupied = {};
  function isFree(c, r, cs, rs){
    for (var dc = 0; dc < cs; dc++){
      for (var dr = 0; dr < rs; dr++){
        if (occupied[(c+dc) + ',' + (r+dr)]) return false;
        if (c + dc > 4) return false;
      }
    }
    return true;
  }
  function markOccupied(c, r, cs, rs){
    for (var dc = 0; dc < cs; dc++){
      for (var dr = 0; dr < rs; dr++){
        occupied[(c+dc) + ',' + (r+dr)] = true;
      }
    }
  }
  // First pass: register positions for widgets that already have one
  prefs.adminTileOrder.forEach(function(id){
    var pos = positions[id];
    if (pos){
      var t = tileDefs[id]; if (!t) return;
      var sz = prefs.adminTileSizes[id] || {c:t.defC, r:t.defR};
      markOccupied(pos.col, pos.row, sz.c, sz.r);
    }
  });
  // Second pass: assign positions to widgets that don't have one
  var dirty = false;
  prefs.adminTileOrder.forEach(function(id){
    if (positions[id]) return;
    var t = tileDefs[id]; if (!t) return;
    var sz = prefs.adminTileSizes[id] || {c:t.defC, r:t.defR};
    for (var r = 1; r <= 20; r++){
      for (var c = 1; c <= 4 - sz.c + 1; c++){
        if (isFree(c, r, sz.c, sz.r)){
          positions[id] = {col:c, row:r};
          markOccupied(c, r, sz.c, sz.r);
          dirty = true;
          c = 99; r = 99;
        }
      }
    }
  });
  if (dirty){
    prefs.adminTilePositions = positions;
    google.script.run.saveMyPrefs(JSON.stringify(prefs));
  }

  grid.innerHTML = prefs.adminTileOrder.map(function(id){
    var t = tileDefs[id];
    if (!t) return '';
    var sz = prefs.adminTileSizes[id] || {c:t.defC, r:t.defR};
    var colSpan = Math.min(Math.max(sz.c || t.defC, 1), 4);
    var rowSpan = Math.min(Math.max(sz.r || t.defR, 1), 3);
    var minH = (rowSpan * 180) + ((rowSpan - 1) * 14);
    var pos = positions[id] || {col:1, row:1};

    return '<div class="tile" id="tile-' + id + '" data-tile="' + id + '" '
      + 'style="grid-column:' + pos.col + ' / span ' + colSpan + ';grid-row:' + pos.row + ' / span ' + rowSpan + ';min-height:' + minH + 'px;">'
      + '<div class="card" style="display:flex;flex-direction:column;height:100%;overflow:hidden;">'
      +   '<div class="card-top">'
      +     '<div class="card-lbl"><svg class="ui-ic-sm" viewBox="0 0 24 24"><use href="' + t.svg + '"/></svg> ' + t.title + '</div>'
      +   '</div>'
      +   '<div class="t-widget-body t-widget-scroll" id="aw-' + id + '"><div style="color:var(--tx3);font-size:12px;padding:20px;text-align:center;">Loading...</div></div>'
      + '</div></div>';
  }).join('');

  // Defer widget renders so the DOM has time to paint shells first.
  setTimeout(function(){
    prefs.adminTileOrder.forEach(function(id){
      var t = tileDefs[id];
      if (!t) return;
      try {
        t.fn();
      } catch(e){
        var el = document.getElementById('aw-' + id);
        if (el) el.innerHTML = '<div style="color:#f87171;font-size:12px;padding:10px;">Error: ' + esc(e.message) + '</div>';
        console.error(e);
      }
    });
    }, 50);
}


/* ═══════════════════════════════════════════════════════════════════
   3. TILE SIZE PICKER
   Floating popup over a tile's gear icon with a 4×2 grid of size choices.
   ═══════════════════════════════════════════════════════════════════ */

// Open the size picker for an admin tile. Clicking the same tile's gear
// twice closes the popup; clicking outside also closes.
function openASzPicker(id, evt){
  evt.stopPropagation();
  // Close any existing popup first; if it was for the same tile, just close
  var old = document.getElementById('sz-pop');
  if (old){ old.remove(); if (old.dataset.wid === id) return; }

  // Default sizes (must match buildAdminPage's tileDefs)
  var defs = {abell:{c:2,r:2},aschedcal:{c:4,r:2},astats:{c:2,r:1},arepair:{c:2,r:1},alunch:{c:4,r:2},agrad:{c:2,r:2},arow:{c:4,r:2},arem:{c:2,r:2},aclean:{c:4,r:2}};
  var cur = Object.assign({}, defs[id] || {c:2,r:2}, (prefs.adminTileSizes && prefs.adminTileSizes[id]) || {});

  // Build the popup
  var pop = document.createElement('div');
  pop.id = 'sz-pop';
  pop.dataset.wid = id;
  pop.className = 'sz-pop';
  var html = '<div class="sz-pop-title">Size (cols \u00d7 rows)</div><div class="sz-grid">';
  for (var r = 1; r <= 2; r++){
    for (var c = 1; c <= 4; c++){
      var isSel = (c === cur.c && r === cur.r) ? ' sel' : '';
      html += '<div class="sz-cell' + isSel + '" onclick="pickASz(\'' + id + '\',' + c + ',' + r + ')">' + c + '\u00d7' + r + '</div>';
    }
  }
  html += '</div>';
  pop.innerHTML = html;
  document.body.appendChild(pop);

  // Position the popup near the tile's gear, clamped to viewport
  var tile  = document.getElementById('tile-' + id);
  var tRect = tile ? tile.getBoundingClientRect() : {top:100, bottom:300, left:100, right:400};
  var popW = 215, popH = 152;
  var left = tRect.right - popW - 14;
  var top  = tRect.bottom - popH - 44;
  if (left < tRect.left + 8) left = tRect.left + 8;
  if (top  < tRect.top  + 8) top  = tRect.top  + 8;
  if (left + popW > window.innerWidth  - 8) left = window.innerWidth  - popW - 8;
  if (top  + popH > window.innerHeight - 8) top  = window.innerHeight - popH - 8;
  if (left < 8) left = 8;
  if (top  < 8) top  = 8;
  pop.style.top  = top  + 'px';
  pop.style.left = left + 'px';

  // Click-outside to close (registered with a tiny delay so this click doesn't trigger it)
  setTimeout(function(){
    function away(e){ if (!pop.contains(e.target)){ pop.remove(); document.removeEventListener('click', away); } }
    document.addEventListener('click', away);
  }, 10);
}

// User picked a size from the popup → save to prefs, update the tile's
// CSS spans, persist prefs to server.
function pickASz(id, cols, rows){
  if (!prefs.adminTileSizes) prefs.adminTileSizes = {};
  prefs.adminTileSizes[id] = {c:cols, r:rows};

  var tile = document.getElementById('tile-' + id);
  if (tile){
    var minH = (rows * 180) + ((rows - 1) * 14);
    tile.style.gridColumn = 'span ' + cols;
    tile.style.gridRow    = 'span ' + rows;
    tile.style.minHeight  = minH + 'px';
  }

  var pop = document.getElementById('sz-pop');
  if (pop) pop.remove();
  google.script.run.saveMyPrefs(JSON.stringify(prefs));
}


/* ═══════════════════════════════════════════════════════════════════
   4. WIDGET RENDERERS
   Each function paints the widget body's static HTML shell, then
   triggers async loads where applicable. These run from buildAdminPage's
