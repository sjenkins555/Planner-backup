    +   '<button class="btn btn-primary btn-sm" onclick="openBellEditor()">+ New</button>'
    + '</div>'
    + '<div id="bell-list" style="display:flex;flex-direction:column;gap:6px;padding:0 4px;"><div style="color:var(--tx4);font-size:12px;text-align:center;padding:10px;">Loading...</div></div>';
