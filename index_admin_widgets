  }).join('') || '<div style="color:var(--tx2);font-size:12px;padding:12px;text-align:center;">No grading periods yet. Add your first one below.</div>';

  b.innerHTML = rows
    + '<div style="display:flex;gap:6px;margin-top:8px;">'
    +   '<button onclick="aTermAdd()" style="flex:1;padding:7px 10px;background:transparent;color:var(--a2);border:1px solid var(--a4);border-radius:7px;font-size:12px;font-weight:600;cursor:pointer;font-family:inherit;">+ Add Period</button>'
    +   '<button onclick="aTermQuickFill()" style="flex:1;padding:7px 10px;background:transparent;color:var(--tx2);border:1px solid var(--border);border-radius:7px;font-size:12px;font-weight:600;cursor:pointer;font-family:inherit;">Fill 4 Quarters</button>'
    + '</div>'
    + '<div id="aterm-msg" style="font-size:11px;min-height:14px;margin:7px 0;color:#f87171;"></div>'
    + '<button id="aterm-save" onclick="aTermSave()" style="width:100%;padding:8px 10px;background:#4f46e5;color:#fff;border:none;border-radius:7px;font-size:12px;font-weight:700;cursor:pointer;font-family:inherit;">Save Grading Periods</button>';
}

function aTermEdit(i, field, val){
  if (!_aTermDraft || !_aTermDraft[i]) return;
  _aTermDraft[i][field] = val;   // no re-render — keeps focus in the field
}

function aTermAdd(){
  if (!_aTermDraft) _aTermDraft = [];
  _aTermDraft.push({id:'gp-' + Date.now(), name:'', start:'', end:''});
  renderATermRows();
}

function aTermRemove(i){
  if (!_aTermDraft) return;
  _aTermDraft.splice(i, 1);
  renderATermRows();
}

// Scaffold four empty quarters so you're only filling in dates.
function aTermQuickFill(){
  if (_aTermDraft && _aTermDraft.length && !confirm('Replace the current list with four blank quarters?')) return;
  var now = new Date();
  var sy = now.getMonth() >= 7 ? now.getFullYear() : now.getFullYear() - 1;
  _aTermDraft = [1,2,3,4].map(function(n){
    return {id:'gp-' + Date.now() + '-' + n, name:'Quarter ' + n + ' (' + sy + '-' + String(sy+1).slice(2) + ')', start:'', end:''};
  });
  renderATermRows();
}

function aTermSave(){
  var msg = document.getElementById('aterm-msg');
  var btn = document.getElementById('aterm-save');
  msg.style.color = '#f87171';

  var list = _aTermDraft || [];
  for (var i = 0; i < list.length; i++){
    if (!String(list[i].name || '').trim()){ msg.textContent = 'Every period needs a name.'; return; }
    if (!list[i].start || !list[i].end){ msg.textContent = 'Pick both dates for "' + list[i].name + '".'; return; }
    if (list[i].end < list[i].start){ msg.textContent = '"' + list[i].name + '" ends before it starts.'; return; }
  }

  btn.disabled = true;
  btn.textContent = 'Saving...';
  google.script.run.withSuccessHandler(function(r){
    btn.disabled = false;
    btn.textContent = 'Save Grading Periods';
    if (r && r.success){
      _aTermDraft = r.periods.slice();
      if (typeof GRADING_PERIODS !== 'undefined'){ GRADING_PERIODS = r.periods.slice(); _gpLoaded = true; }
      toast('Grading periods saved', 'ok');
      renderATermRows();
    } else {
      msg.style.color = '#f87171';
      msg.textContent = (r && r.error) || 'Could not save.';
    }
  }).withFailureHandler(function(e){
    btn.disabled = false;
    btn.textContent = 'Save Grading Periods';
    msg.style.color = '#f87171';
    msg.textContent = (e && e.message) || 'Server error.';
  }).setGradingPeriods(JSON.stringify(list));
}
