}

// Expand an inline edit form under a reminder row.
function aRemEdit(id){
  var box = document.getElementById('arem-edit-' + id);
  if (!box) return;
  if (box.innerHTML){ box.innerHTML = ''; return; }

  var rm = null;
  var cache = window._aRemCache || [];
  for (var i = 0; i < cache.length; i++){ if (cache[i].id === id){ rm = cache[i]; break; } }
  if (!rm) return;

  var localWhen = '';
  if (rm.triggerAt){
    try {
      var d = new Date(rm.triggerAt);
      localWhen = d.getFullYear() + '-' + String(d.getMonth()+1).padStart(2,'0') + '-' + String(d.getDate()).padStart(2,'0')
        + 'T' + String(d.getHours()).padStart(2,'0') + ':' + String(d.getMinutes()).padStart(2,'0');
    } catch(e){}
  }

  box.innerHTML = '<div style="border-top:1px solid var(--border);margin-top:8px;padding-top:8px;">'
    + '<input class="finp" id="arem-e-title-' + id + '" value="' + esc(rm.title) + '" style="margin-bottom:5px;font-size:12px;" maxlength="100">'
    + '<textarea class="fta" id="arem-e-body-' + id + '" style="min-height:44px;margin-bottom:5px;font-size:12px;" maxlength="300">' + esc(rm.body) + '</textarea>'
    + '<input type="datetime-local" class="finp" id="arem-e-when-' + id + '" value="' + localWhen + '" style="margin-bottom:6px;width:100%;font-size:12px;">'
    + '<div style="display:flex;gap:6px;">'
    +   '<button onclick="aRemEdit(\'' + id + '\')" style="flex:1;padding:5px 8px;background:transparent;color:var(--tx3);border:1px solid var(--border);border-radius:6px;font-size:11px;cursor:pointer;font-family:inherit;">Cancel</button>'
    +   '<button onclick="aRemSaveEdit(\'' + id + '\')" style="flex:1;padding:5px 8px;background:#4f46e5;color:#fff;border:none;border-radius:6px;font-size:11px;font-weight:600;cursor:pointer;font-family:inherit;">Save changes</button>'
    + '</div></div>';
}

function aRemSaveEdit(id){
  var title = ((document.getElementById('arem-e-title-' + id) || {}).value || '').trim();
  var body  = ((document.getElementById('arem-e-body-'  + id) || {}).value || '').trim();
  var when  =  (document.getElementById('arem-e-when-'  + id) || {}).value || '';
  if (!title){ toast('Title required', 'err'); return; }
  var iso = when ? new Date(when).toISOString() : '';
  google.script.run.withSuccessHandler(function(r){
    if (r && r.success){ toast('Reminder updated', 'ok'); aRemLoadSent(); }
    else toast((r && r.error) || 'Could not save', 'err');
  }).withFailureHandler(function(e){
    toast((e && e.message) || 'Could not save', 'err');
  }).adminUpdateReminder(id, title, body, iso);
}

function aRemDelete(id){
  if (!confirm('Remove this reminder for everyone?\n\nIt will disappear from every student and teacher\'s planner.')) return;
  google.script.run.withSuccessHandler(function(r){
    if (r && r.success){
      toast('Reminder removed', 'inf');
      aRemLoadSent();
      if (typeof loadReminders === 'function') loadReminders();
    } else toast((r && r.error) || 'Could not remove', 'err');
  }).withFailureHandler(function(e){
    toast((e && e.message) || 'Could not remove', 'err');
  }).deleteReminder(id);
}

