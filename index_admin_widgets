    if (b) b.innerHTML = '<div style="color:#f87171;font-size:12px;">' + esc((e && e.message) || 'Could not load') + '</div>';
  }).getGradingPeriods();
}

function renderATermRows(){
  var b = document.getElementById('aterm-body');
  if (!b) return;
  var list = _aTermDraft || [];

  var rows = list.map(function(p, i){
    return '<div style="background:rgba(255,255,255,.06);border:1px solid var(--border);border-radius:8px;padding:8px 10px;margin-bottom:6px;">'
      + '<div style="display:flex;gap:6px;align-items:center;margin-bottom:6px;">'
      +   '<input class="finp" value="' + esc(p.name) + '" oninput="aTermEdit(' + i + ',\'name\',this.value)" placeholder="Name (e.g. Quarter 1)" style="flex:1;font-size:12px;">'
      +   '<button onclick="aTermRemove(' + i + ')" title="Remove" style="padding:4px 9px;background:#dc2626;color:#fff;border:none;border-radius:5px;font-size:12px;font-weight:700;cursor:pointer;font-family:inherit;">\u2715</button>'
      + '</div>'
      + '<div style="display:grid;grid-template-columns:1fr 1fr;gap:6px;">'
      +   '<div><div style="font-size:10px;color:var(--tx2);margin-bottom:2px;">STARTS</div><input type="date" class="finp" value="' + esc(p.start) + '" onchange="aTermEdit(' + i + ',\'start\',this.value)" style="width:100%;font-size:12px;"></div>'
      +   '<div><div style="font-size:10px;color:var(--tx2);margin-bottom:2px;">ENDS</div><input type="date" class="finp" value="' + esc(p.end) + '" onchange="aTermEdit(' + i + ',\'end\',this.value)" style="width:100%;font-size:12px;"></div>'
