    + '<div style="display:flex;gap:5px;margin-bottom:8px;">' + catBtn('Respect') + catBtn('Ownership') + catBtn('Teamwork') + '</div>'
    + '<div style="display:flex;gap:8px;align-items:center;margin-bottom:8px;">'
    +   '<div style="font-size:11px;color:var(--tx3);">ROWs</div>'
    +   '<input class="finp" type="number" id="row-award-amt" value="1" min="1" max="10" style="width:60px;text-align:center;font-size:12px;">'
    + '</div>'
    + '<textarea class="fta" id="row-award-desc" placeholder="What did they do? (optional but recommended)" style="min-height:52px;font-size:12px;margin-bottom:8px;" maxlength="500"></textarea>'
    + '<div id="row-award-msg" style="font-size:11px;min-height:14px;margin-bottom:6px;color:#f87171;"></div>'
    + '<button id="row-award-btn" onclick="submitRowAward()" style="width:100%;padding:8px 10px;background:#4f46e5;color:#fff;border:none;border-radius:7px;font-size:12px;font-weight:600;cursor:pointer;font-family:inherit;">Give ROW</button>';

  rowAwardRenderList();
  rowAwardRenderChip();
}

// Render the filtered student list.
function rowAwardRenderList(){
  var el = document.getElementById('row-award-list');
  if (!el) return;

  var list = (typeof students !== 'undefined' && students) ? students : [];
  if (!list.length){
    el.innerHTML = '<div style="color:var(--tx4);font-size:11px;padding:10px;text-align:center;">No students loaded.</div>';
    return;
  }

  var q = ((document.getElementById('row-award-search') || {}).value || '').trim().toLowerCase();
  var filtered = q ? list.filter(function(s){
    return String(s.name || '').toLowerCase().indexOf(q) > -1
        || String(s.email || '').toLowerCase().indexOf(q) > -1;
  }) : list;

  if (!filtered.length){
    el.innerHTML = '<div style="color:var(--tx4);font-size:11px;padding:10px;text-align:center;">No matches.</div>';
    return;
  }

  el.innerHTML = filtered.slice(0, 60).map(function(s){
    var on = s.email === _rowAwardSel;
    return '<div onclick="rowAwardPick(\'' + esc(s.email) + '\')" style="padding:5px 8px;border-radius:6px;cursor:pointer;font-size:12px;margin-bottom:2px;background:' + (on ? 'var(--a3)' : 'transparent') + ';color:' + (on ? 'var(--a2)' : 'var(--tx2)') + ';">'
      + '<div style="font-weight:600;">' + esc(s.name) + '</div>'
      + '<div style="font-size:10px;color:var(--tx4);">' + esc(s.email) + '</div>'
      + '</div>';
  }).join('') + (filtered.length > 60 ? '<div style="font-size:10px;color:var(--tx4);padding:5px;text-align:center;">+' + (filtered.length - 60) + ' more — keep typing to narrow</div>' : '');
}

// Show who's currently selected.
function rowAwardRenderChip(){
  var el = document.getElementById('row-award-chip');
  if (!el) return;
  if (!_rowAwardSel){ el.innerHTML = '<div style="font-size:11px;color:var(--tx4);">No student selected yet.</div>'; return; }
  var name = _rowAwardSel;
  var list = (typeof students !== 'undefined' && students) ? students : [];
  for (var i = 0; i < list.length; i++){ if (list[i].email === _rowAwardSel){ name = list[i].name; break; } }
  el.innerHTML = '<div style="display:inline-flex;align-items:center;gap:6px;background:var(--a3);border:1px solid var(--a4);color:var(--a2);border-radius:99px;padding:3px 10px;font-size:11px;font-weight:600;">Giving to: ' + esc(name) + '</div>';
}

function rowAwardPick(email){ _rowAwardSel = email; rowAwardRenderList(); rowAwardRenderChip(); }
function rowAwardCat(c){ _rowAwardCat = c; renderRowAwardForm(); }

// Submit the award.
function submitRowAward(){
  var msg = document.getElementById('row-award-msg');
  var btn = document.getElementById('row-award-btn');
  msg.style.color = '#f87171';

  if (!_rowAwardSel){ msg.textContent = 'Pick a student from the list first.'; return; }
  var amt = parseInt((document.getElementById('row-award-amt') || {}).value, 10);
  if (isNaN(amt) || amt < 1 || amt > 10){ msg.textContent = 'ROWs must be between 1 and 10.'; return; }
  var desc = ((document.getElementById('row-award-desc') || {}).value || '').trim();

  btn.disabled = true;
  btn.textContent = 'Giving...';
  msg.style.color = 'var(--tx3)';
  msg.textContent = 'Saving...';

  google.script.run.withSuccessHandler(function(r){
    btn.disabled = false;
    btn.textContent = 'Give ROW';
    if (r && r.success){
      toast('+' + amt + ' ROW to ' + (r.studentName || 'student') + ' (now ' + r.newBalance + ')', 'ok');
      _rowAwardSel = '';
      renderRowAwardForm();
    } else {
      msg.style.color = '#f87171';
      msg.textContent = (r && r.error) || 'Could not give ROW.';
    }
  }).withFailureHandler(function(e){
    btn.disabled = false;
    btn.textContent = 'Give ROW';
    msg.style.color = '#f87171';
    msg.textContent = (e && e.message) || 'Server error.';
  }).awardRow(_rowAwardSel, amt, _rowAwardCat, desc);
}


/* ═══════════════════════════════════════════════════════════════════
   5. VIEW STUDENT WIDGET — handlers
   Loads a student's planner data, renders task list with per-list filter
   tabs, supports inline add/delete of tasks.
   ═══════════════════════════════════════════════════════════════════ */

// Fetch the selected student's planner data and render it inside #tvw-content.
// Renders task counts (pending/done), an Add task button, optional task-list
// tab bar (only if the student has more than one list), and the first 8 tasks.
function loadTViewInline(){
  var sel = document.getElementById('tvw-sel');
  if (!sel || !sel.value) return;
  var email   = sel.value;
  var content = document.getElementById('tvw-content');
  content.innerHTML = '<div style="color:var(--tx3);font-size:12px;padding:20px;text-align:center;">Loading...</div>';

  google.script.run.withSuccessHandler(function(r){
    if (!r.success){ content.innerHTML = '<div style="color:#ef4444;font-size:12px;">' + esc(r.error || 'Error') + '</div>'; return; }

    // Resolve student name (for the Add Task button label)
    var name = '';
    for (var i = 0; i < students.length; i++){ if (students[i].email === email) name = students[i].name; }

    var allTasks = r.tasks || [];
    var lists    = r.taskLists || [{id:'default', name:'All Tasks', color:'#6366f1'}];
    var listMap  = r.taskListMap || {};

    // If the student deleted the list we were filtering by, fall back to default
    if (!lists.some(function(l){ return l.id === _tvwActiveList; })) _tvwActiveList = 'default';

    // Filter tasks to currently-selected list. The 'default' list shows everything.
    var filteredTasks = allTasks.filter(function(t){ return _tvwActiveList === 'default' || listMap[t.id] === _tvwActiveList; });
    var pending = filteredTasks.filter(function(t){ return t.status !== 'completed'; });
    var done    = filteredTasks.filter(function(t){ return t.status === 'completed'; });

    // Tab bar — only render if the student has 2+ task lists
    var tabBar = '';
    if (lists.length > 1){
      tabBar = '<div style="display:flex;gap:3px;margin-bottom:8px;flex-wrap:wrap;">' + lists.map(function(l){
        var count  = allTasks.filter(function(t){ return l.id === 'default' || listMap[t.id] === l.id; }).length;
        var active = l.id === _tvwActiveList;
        return '<button class="t-mini-tab' + (active ? ' active' : '') + '" style="' + (active ? 'background:' + l.color + '20;color:' + l.color + ';' : '') + '" onclick="tvwSwitchList(\'' + l.id + '\')">'
          + '<span style="display:inline-block;width:7px;height:7px;border-radius:50%;background:' + l.color + ';margin-right:5px;vertical-align:1px;"></span>'
          + esc(l.name) + ' <span style="opacity:.6;font-weight:500;">(' + count + ')</span></button>';
      }).join('') + '</div>';
    }

    // Task rows (first 8) — completed tasks render struck through + faded
    var taskRows = filteredTasks.slice(0, 8).map(function(t){
      return '<div style="display:flex;align-items:center;gap:7px;padding:5px 8px;background:rgba(15,23,42,.6);border:1px solid var(--border);border-radius:7px;margin-bottom:4px;font-size:12px;' + (t.status === 'completed' ? 'opacity:.45;' : '') + '">'
        + '<div class="dot ' + t.priority + '"></div>'
        + '<span style="flex:1;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;' + (t.status === 'completed' ? 'text-decoration:line-through;' : '') + '">' + esc(t.title) + '</span>'
        + (t.dueDate ? '<span style="font-size:10px;color:var(--tx4);">' + fmtDate(t.dueDate) + '</span>' : '')
        + '<button class="btn btn-danger btn-sm" onclick="tDelTaskInline(\'' + t.id + '\')" style="padding:2px 6px;"><svg class="ui-ic-sm" viewBox="0 0 16 16"><use href="#w-x"/></svg></button>'
        + '</div>';
    }).join('') || '<div style="color:var(--tx4);font-size:12px;padding:12px;text-align:center;">No tasks in this list</div>';

    content.innerHTML = ''
      + '<div style="display:flex;gap:6px;margin-bottom:8px;font-size:11px;">'
      +   '<div style="background:var(--a5);border:1px solid var(--a4);color:var(--a2);border-radius:6px;padding:3px 8px;font-weight:600;">' + pending.length + ' pending</div>'
      +   '<div style="background:rgba(34,197,94,.08);border:1px solid rgba(34,197,94,.25);color:#22c55e;border-radius:6px;padding:3px 8px;font-weight:600;">' + done.length + ' done</div>'
      +   '<button class="btn btn-primary btn-sm" style="margin-left:auto;font-size:11px;" onclick="openTAddInline(\'' + esc(email) + '\',\'' + esc(name) + '\')">Add task</button>'
      + '</div>'
      + tabBar
      + taskRows
      + (filteredTasks.length > 8 ? '<div style="text-align:center;font-size:11px;color:var(--tx4);margin-top:6px;">+' + (filteredTasks.length - 8) + ' more</div>' : '');
  }).getStudentPlannerData(email);
}

// Switch the task-list filter in the View Student widget and re-render.
function tvwSwitchList(id){
  _tvwActiveList = id;
  loadTViewInline();
}

// Replace the View Student content with an inline Add Task form.
// Cancel re-runs loadTViewInline; Add submits to teacherAddTaskToStudent.
function openTAddInline(email, name){
  var content = document.getElementById('tvw-content');
  content.innerHTML = '<div style="font-size:10px;font-weight:700;color:var(--a2);letter-spacing:.5px;text-transform:uppercase;margin-bottom:8px;">Add task for ' + esc(name) + '</div>'
    + '<input class="finp" id="ta-tt" placeholder="—Title—" style="margin-bottom:6px;">'
    + '<div style="display:grid;grid-template-columns:1fr 1fr;gap:5px;margin-bottom:6px;">'
    +   '<input class="finp" id="ta-ts" placeholder="—Subject—">'
    +   '<select class="fsel" id="ta-tp"><option value="high">High</option><option value="medium" selected>Medium</option><option value="low">Low</option></select>'
    + '</div>'
    + '<input type="date" class="finp" id="ta-td" style="margin-bottom:6px;">'
    + '<textarea class="fta" id="ta-tn" placeholder="—Notes—" style="min-height:44px;font-size:12px;margin-bottom:8px;"></textarea>'
    + '<div style="display:flex;gap:5px;justify-content:flex-end;">'
    +   '<button class="btn btn-ghost   btn-sm" onclick="loadTViewInline()">Cancel</button>'
    +   '<button class="btn btn-primary btn-sm" onclick="doTAddInline(\'' + esc(email) + '\')">Add</button>'
    + '</div>';
  document.getElementById('ta-tt').focus();
}

// Submit the inline add-task form. Reloads the viewer on success.
function doTAddInline(email){
  var title = (document.getElementById('ta-tt').value || '').trim();
  if (!title){ toast('Enter a title', 'err'); return; }
  google.script.run.withSuccessHandler(function(r){
    if (r.success){ loadTViewInline(); toast('Task added', 'ok'); }
  }).teacherAddTaskToStudent(
    email,
    title,
    document.getElementById('ta-ts').value.trim(),
    document.getElementById('ta-td').value,
    document.getElementById('ta-tp').value,
    document.getElementById('ta-tn').value.trim()
  );
}

// Delete a task from a student's list (server-side) and reload the viewer.
function tDelTaskInline(id){
  google.script.run.withSuccessHandler(function(r){
    if (r.success){ loadTViewInline(); toast('Deleted', 'inf'); }
  }).teacherDeleteTask(id);
}


/* ═══════════════════════════════════════════════════════════════════
   6. PUSH TASKS WIDGET — handlers
   Target picker (all/group/individual) + optional "also create calendar
   event" checkbox. Calendar invitations include the resolved guest list.
   ═══════════════════════════════════════════════════════════════════ */

// If the "also create calendar event" checkbox is checked, gather the
// task fields + resolved guest list and open the calendar event editor.
// Called BEFORE the push itself fires.
function twMaybeOpenCal(){
  var cb = document.getElementById('tp-cal');
  if (!cb || !cb.checked) return;

  var title = ((document.getElementById('tp-tt') || {}).value || '').trim();
  if (!title) return;
  var due   = (document.getElementById('tp-td') || {}).value || '';
  var notes = ((document.getElementById('tp-tn') || {}).value || '').trim();
  var subj  = ((document.getElementById('tp-ts') || {}).value || '').trim();

  // Resolve guest list from the current target choice
  var guests = [];
  if (_twPushTarget === 'all'){
    guests = students.map(function(s){ return s.email; });
  } else if (_twPushTarget === 'group'){
    var gs    = document.getElementById('twp-gs');
    var gname = gs ? gs.value : '';
    var grp   = groups.filter(function(g){ return g.name === gname; })[0];
    if (grp) guests = grp.emails || [];
  } else if (_twPushTarget === 'individual'){
    var ss = document.getElementById('twp-ss');
    if (ss && ss.value) guests = [ss.value];
  }

  // If subject matches one of teacher's own classes, auto-fill class times
  var classTimes = findClassTimesForSubject(subj, due);
  openCalendarEvent(title, due, notes, guests, classTimes);
}

// Set the Push Tasks target and update the visual selected state + detail row.
function twSetPT(t){
  _twPushTarget = t;
  ['all','group','ind'].forEach(function(x){
    var el = document.getElementById('twp-' + x);
    if (el) el.classList.remove('sel');
  });
  // 'individual' uses element id 'ind' for compactness
  var key = t === 'individual' ? 'ind' : t;
  var el = document.getElementById('twp-' + key);
  if (el) el.classList.add('sel');
  twRenderPTDet();
}

// Render the per-target detail UI: count text for "all", group dropdown
// for "group", student dropdown for "individual".
function twRenderPTDet(){
  var el = document.getElementById('twp-det');
  if (!el) return;

  if (_twPushTarget === 'all'){
    el.innerHTML = '<div style="font-size:11px;color:var(--tx3);background:var(--bg3);border:1px solid var(--border);border-radius:6px;padding:6px 10px;">Sends to all ' + students.length + ' student(s)</div>';
    return;
  }
  if (_twPushTarget === 'group'){
    var gO = groups.map(function(g){ return '<option value="' + esc(g.name) + '">' + esc(g.name) + ' (' + g.emails.length + ')</option>'; }).join('');
    el.innerHTML = gO ? '<select class="fsel" id="twp-gs">' + gO + '</select>' : '<div style="color:var(--tx3);font-size:11px;">No groups yet.</div>';
    return;
  }
  // individual
  var sO = students.map(function(s){ return '<option value="' + esc(s.email) + '">' + esc(s.name) + '</option>'; }).join('');
  el.innerHTML = sO ? '<select class="fsel" id="twp-ss">' + sO + '</select>' : '<div style="color:var(--tx3);font-size:11px;">No students yet.</div>';
}


