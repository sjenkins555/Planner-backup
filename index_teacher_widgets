<script>
/* ═══════════════════════════════════════════════════════════════════
   ║  index_teacher_widgets.html — TEACHER TOOLS TAB CHUNK
   ║  ───────────────────────────────────────────────────
   ║  Owns the Teacher Tools tab: 6 widgets in a draggable/resizable grid.
   ║  Only renders for users with role === 'teacher' (router enforces this).
   ║
   ║  Widgets (teacher tile IDs):
   ║    tview   — View Student (browse a single student's planner)
   ║    tgrp    — Groups (create/edit student groups)
   ║    tpush   — Push Tasks (send a task to all/group/one student)
   ║    talink  — Assign Links (push links to all/group/one student)
   ║    tembed  — Embed Documents (push a Google Doc/Sheet/Slide/Form)
   ║    trem    — Send Reminder (push a reminder to all/group/one student)
   ║
   ║  TABLE OF CONTENTS
   ║  ─────────────────
   ║   1. STATE (per-widget UI flags + caches)
   ║   2. PAGE BUILDER (buildTeacherDashboard)
   ║   3. TILE SIZE PICKER (openTSzPicker, pickTSz)
   ║   4. WIDGET RENDERERS — shell HTML for each of the 6 widgets
   ║   5. VIEW STUDENT — load + inline add/delete tasks
   ║   6. PUSH TASKS — target picker + calendar-event opt-in
   ║   7. ASSIGN LINKS — tabbed Add / Current Links
   ║   8. EMBED DOCUMENTS — tabbed Embed New / Current Docs
   ║   9. SEND REMINDER — target picker + datetime
   ║  10. GROUPS MODAL (openGrpModal, doSaveGroup, doDelGroup)
   ║  11. LEGACY PUSH PAGE (older standalone push UI — see notes)
   ║  12. HELPERS (loadStuGroups data prefetch)
   ═══════════════════════════════════════════════════════════════════ */


/* ═══════════════════════════════════════════════════════════════════
   1. STATE
   Per-widget UI flags. Most widgets remember their currently-selected
   target (all/group/individual) and which tab they're on.
   _tvwActiveList tracks the View Student widget's task-list filter.
   ═══════════════════════════════════════════════════════════════════ */

var _tvwActiveList = 'default'; // currently-shown task list in View Student widget
var _twPushTarget  = 'all';     // Push Tasks: 'all' | 'group' | 'individual'
var _twLinkTarget  = 'all';     // Assign Links: 'all' | 'group' | 'individual'
var _twLinkTab     = 'add';     // Assign Links: 'add' | 'list'
var _twEdTarget    = 'all';     // Embed Docs: 'all' | 'group' | 'individual' | 'self'
var _twEdTab       = 'add';     // Embed Docs: 'add' | 'list'
var _twRemTarget   = 'all';     // Send Reminder: 'all' | 'group' | 'individual'
var _tRowTab       = 'pending'; // ROW widget: 'pending' | 'award'
var _rowAwardSel   = '';        // email of the student selected to receive a ROW
var _rowAwardCat   = 'Respect'; // Respect | Ownership | Teamwork
var _tGrpTab       = 'list';    // Groups widget: 'list' | 'edit'
var _grpEditName   = '';        // group being edited ('' = creating new)
var _tPickTab      = 'draw';    // ROW Picker: 'draw' | 'drawn'
var _tPickGrade    = 'all';     // 'all' | '6' | '7' | '8'
var _tPickPool     = null;      // cached eligible students
var _tPickResult   = null;      // last student drawn


/* ═══════════════════════════════════════════════════════════════════
   2. PAGE BUILDER
   Builds the 6-widget grid. Order/size persist via prefs.teacherTileOrder
   and prefs.teacherTileSizes. Loads students+groups first, then renders.
   ═══════════════════════════════════════════════════════════════════ */

// Build the Teacher Tools tab. Defers widget renders by 50ms so the
// grid paints before any async loads kick in.
// Lazily resolve a renderer by name at call time instead of at object-literal
// build time. A missing renderer now degrades to one broken tile instead of
// taking down the entire dashboard.
function _twRenderer(name, tileId){
  return function(){
    var f = window[name];
    if (typeof f === 'function') return f();
    console.warn('[teacher] missing renderer: ' + name);
    var el = document.getElementById('tw-' + tileId);
    if (el) el.innerHTML = '<div style="color:#f87171;font-size:12px;padding:10px;line-height:1.5;">'
      + 'Widget unavailable.<br><span style="color:var(--tx3);font-size:11px;">' + name + '() is not loaded.</span></div>';
  };
}

function buildTeacherDashboard(){
  // Tile definitions — one per teacher widget
  var tileDefs = {
    tview:        {fn:_twRenderer('renderTViewWidget','tview'),                title:'View Student',    svg:'#w-student',    defC:2, defR:2},
    tgrp:         {fn:_twRenderer('renderTGroupsWidget','tgrp'),               title:'Groups',          svg:'#w-group',      defC:2, defR:2},
    tpush:        {fn:_twRenderer('renderTPushWidget','tpush'),                title:'Push Tasks',      svg:'#w-push',       defC:2, defR:2},
    talink:       {fn:_twRenderer('renderTLinkWidget','talink'),               title:'Assign Links',    svg:'#w-assignlink', defC:2, defR:2},
    trem:         {fn:_twRenderer('renderTReminderWidget','trem'),             title:'Send Reminder',   svg:'#w-timer',      defC:2, defR:2},
    rowapprovals: {fn:_twRenderer('renderTRowApprovalsWidget','rowapprovals'), title:'ROW Approvals',   svg:'#w-rowoars',    defC:2, defR:2},
    tpick:        {fn:_twRenderer('renderTPickWidget','tpick'),                title:'ROW Picker',      svg:'#w-student',    defC:2, defR:2}
  };

  // Reconcile saved order with the canonical default — drop unknown IDs,
  // append any new IDs that weren't saved before.
  var defaultOrder = ['tview','tgrp','tpush','talink','trem','rowapprovals','tpick'];
  if (!prefs.teacherTileOrder || !prefs.teacherTileOrder.length){
    prefs.teacherTileOrder = defaultOrder.slice();
  } else {
    var saved = prefs.teacherTileOrder.filter(function(id){ return tileDefs[id]; });
    var removed = prefs.teacherTileRemoved || [];
    defaultOrder.forEach(function(id){
      if (saved.indexOf(id) === -1 && removed.indexOf(id) === -1) saved.push(id);
    });
    prefs.teacherTileOrder = saved;
  }
  if (!prefs.teacherTileSizes) prefs.teacherTileSizes = {};
  if (!prefs.teacherTilePositions) prefs.teacherTilePositions = {};

  // Register catalog so the layout editor can list teacher widgets in its rail
  window.TEACHER_WIDGETS = Object.keys(tileDefs).map(function(k){ return {id:k, name:tileDefs[k].title}; });
  Object.keys(tileDefs).forEach(function(k){ if (typeof DEF_TILE_SIZES === 'object' && !DEF_TILE_SIZES[k]) DEF_TILE_SIZES[k] = {c:tileDefs[k].defC, r:tileDefs[k].defR}; });

  // Render the panel shell with a Customize Layout button above the grid
  panel('t-dash').innerHTML = '<div style="display:flex;justify-content:flex-end;padding:0 0 12px;"><button class="btn btn-primary btn-sm" onclick="openLayoutEditor(\'teacher\')"><svg viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right:4px;vertical-align:-2px;"><circle cx="8" cy="8" r="3"/><path d="M8 1v2M8 13v2M3.5 3.5l1.4 1.4M11.1 11.1l1.4 1.4M1 8h2M13 8h2M3.5 12.5l1.4-1.4M11.1 4.9l1.4-1.4"/></svg>Customize Layout</button></div><div class="tile-grid" id="t-tile-grid" style="grid-auto-rows:minmax(180px,auto);"></div>';

  // Pre-fetch students + groups so widgets like Push/Links/Embed can
  // populate their dropdowns immediately on first render.
  loadStuGroups(function(){
    var grid = document.getElementById('t-tile-grid');
    if (!grid) return;

    // ─── Position handling ──────────────────────────────────────────
    // Auto-assign positions to any widgets that don't have one yet.
    // Walks the grid row-by-row finding the first empty slot that fits.
    var positions = prefs.teacherTilePositions || {};
    var occupied = {};
    function isFree(c, r, cs, rs){
      for (var dc = 0; dc < cs; dc++){
        for (var dr = 0; dr < rs; dr++){
          if (occupied[(c+dc) + ',' + (r+dr)]) return false;
          if (c + dc > 4) return false;
        }
      }
      return true;
    }
    function markOccupied(c, r, cs, rs){
      for (var dc = 0; dc < cs; dc++){
        for (var dr = 0; dr < rs; dr++){
          occupied[(c+dc) + ',' + (r+dr)] = true;
        }
      }
    }
    // First pass: register positions for widgets that already have one
    prefs.teacherTileOrder.forEach(function(id){
      var pos = positions[id];
      if (pos){
        var t = tileDefs[id]; if (!t) return;
        var sz = prefs.teacherTileSizes[id] || {c:t.defC, r:t.defR};
        markOccupied(pos.col, pos.row, sz.c, sz.r);
      }
    });
    // Second pass: assign positions to widgets that don't have one
    var dirty = false;
    prefs.teacherTileOrder.forEach(function(id){
      if (positions[id]) return;
      var t = tileDefs[id]; if (!t) return;
      var sz = prefs.teacherTileSizes[id] || {c:t.defC, r:t.defR};
      for (var r = 1; r <= 20; r++){
        for (var c = 1; c <= 4 - sz.c + 1; c++){
          if (isFree(c, r, sz.c, sz.r)){
            positions[id] = {col:c, row:r};
            markOccupied(c, r, sz.c, sz.r);
            dirty = true;
            c = 99; r = 99;
          }
        }
      }
    });
    if (dirty){
      prefs.teacherTilePositions = positions;
      google.script.run.saveMyPrefs(JSON.stringify(prefs));
    }

    grid.innerHTML = prefs.teacherTileOrder.map(function(id){
      var t = tileDefs[id];
      if (!t) return '';
      var sz = prefs.teacherTileSizes[id] || {c:t.defC, r:t.defR};
      var colSpan = Math.min(Math.max(sz.c || t.defC, 1), 4);
      var rowSpan = Math.min(Math.max(sz.r || t.defR, 1), 3);
      var minH = (rowSpan * 180) + ((rowSpan - 1) * 14);
      var pos = positions[id] || {col:1, row:1};

      return '<div class="tile" id="tile-' + id + '" data-tile="' + id + '" '
        + 'style="grid-column:' + pos.col + ' / span ' + colSpan + ';grid-row:' + pos.row + ' / span ' + rowSpan + ';min-height:' + minH + 'px;">'
        + '<div class="card" style="display:flex;flex-direction:column;height:100%;overflow:hidden;">'
        +   '<div class="card-top">'
        +     '<div class="card-lbl"><svg class="ui-ic-sm" viewBox="0 0 24 24"><use href="' + t.svg + '"/></svg> ' + t.title + '</div>'
        +   '</div>'
        +   '<div class="t-widget-body t-widget-scroll" id="tw-' + id + '"><div style="color:var(--tx3);font-size:12px;padding:20px;text-align:center;">Loading...</div></div>'
        + '</div></div>';
    }).join('');

    // Defer renders so DOM paints shells first; isolate per-widget errors.
    setTimeout(function(){
      prefs.teacherTileOrder.forEach(function(id){
        var t = tileDefs[id];
        if (!t) return;
        try {
          t.fn();
        } catch(e){
          var el = document.getElementById('tw-' + id);
          if (el) el.innerHTML = '<div style="color:#f87171;font-size:12px;padding:10px;">Error: ' + esc(e.message) + '</div>';
          console.error(e);
        }
      });
      }, 50);
  });
}


/* ═══════════════════════════════════════════════════════════════════
   3. TILE SIZE PICKER
   Floating popup over a tile's gear icon with a 4×2 grid of size choices.
   Same UX as the admin tab's openASzPicker, but persists to
   prefs.teacherTileSizes.
   ═══════════════════════════════════════════════════════════════════ */

// Open the size picker for a teacher tile. Clicking the same gear twice
// closes the popup. Clicking outside also closes.
function openTSzPicker(id, evt){
  evt.stopPropagation();
  var old = document.getElementById('sz-pop');
  if (old){ old.remove(); if (old.dataset.wid === id) return; }

  // Default sizes (must match buildTeacherDashboard's tileDefs)
  var defs = {tview:{c:2,r:2}, tgrp:{c:2,r:2}, tpush:{c:2,r:2}, talink:{c:2,r:2}, tembed:{c:4,r:2}, trem:{c:2,r:2}, rowapprovals:{c:2,r:2}, tpick:{c:2,r:2}};
  var cur  = Object.assign({}, defs[id] || {c:2,r:2}, (prefs.teacherTileSizes && prefs.teacherTileSizes[id]) || {});

  // Build popup
  var pop = document.createElement('div');
  pop.id = 'sz-pop';
  pop.dataset.wid = id;
  pop.className = 'sz-pop';
  var html = '<div class="sz-pop-title">Size (cols \u00d7 rows)</div><div class="sz-grid">';
  for (var r = 1; r <= 2; r++){
    for (var c = 1; c <= 4; c++){
      var isSel = (c === cur.c && r === cur.r) ? ' sel' : '';
      html += '<div class="sz-cell' + isSel + '" onclick="pickTSz(\'' + id + '\',' + c + ',' + r + ')">' + c + '\u00d7' + r + '</div>';
    }
  }
  html += '</div>';
  pop.innerHTML = html;
  document.body.appendChild(pop);

  // Position popup near the tile's gear, clamped to viewport
  var tile  = document.getElementById('tile-' + id);
  var tRect = tile ? tile.getBoundingClientRect() : {top:100, bottom:300, left:100, right:400};
  var popW = 215, popH = 152;
  var left = tRect.right - popW - 14;
  var top  = tRect.bottom - popH - 44;
  if (left < tRect.left + 8) left = tRect.left + 8;
  if (top  < tRect.top  + 8) top  = tRect.top  + 8;
  if (left + popW > window.innerWidth  - 8) left = window.innerWidth  - popW - 8;
  if (top  + popH > window.innerHeight - 8) top  = window.innerHeight - popH - 8;
  if (left < 8) left = 8;
  if (top  < 8) top  = 8;
  pop.style.top  = top  + 'px';
  pop.style.left = left + 'px';

  // Click-outside-to-close
  setTimeout(function(){
    function away(e){ if (!pop.contains(e.target)){ pop.remove(); document.removeEventListener('click', away); } }
    document.addEventListener('click', away);
  }, 10);
}

// Apply a picked size to the tile + persist to prefs.
function pickTSz(id, cols, rows){
  if (!prefs.teacherTileSizes) prefs.teacherTileSizes = {};
  prefs.teacherTileSizes[id] = {c:cols, r:rows};

  var tile = document.getElementById('tile-' + id);
  if (tile){
    var minH = (rows * 180) + ((rows - 1) * 14);
    tile.style.gridColumn = 'span ' + cols;
    tile.style.gridRow    = 'span ' + rows;
    tile.style.minHeight  = minH + 'px';
  }

  var pop = document.getElementById('sz-pop');
  if (pop) pop.remove();
  google.script.run.saveMyPrefs(JSON.stringify(prefs));
}


/* ═══════════════════════════════════════════════════════════════════
   4. WIDGET RENDERERS
   Each function paints the static HTML shell for its widget body, then
   triggers loads/sub-renderers as needed. Run from buildTeacherDashboard's
   setTimeout so the grid is already on screen.
   ═══════════════════════════════════════════════════════════════════ */

// View Student widget — student dropdown + inline planner viewer.
// Falls back to a separate getMyStudents call if the global `students`
// list isn't populated (e.g. loadStuGroups hadn't loaded yet).
function renderTViewWidget(){
  var el = document.getElementById('tw-tview');
  if (!el) return;

  var stuList = (typeof students !== 'undefined' && students) ? students : [];
  if (!stuList.length){
    el.innerHTML = '<div style="color:var(--tx3);font-size:12px;padding:20px;text-align:center;">Loading students...</div>';
    google.script.run.withSuccessHandler(function(r){
      if (r && r.students){ students = r.students; renderTViewWidget(); }
      else { el.innerHTML = '<div style="color:var(--tx3);font-size:12px;padding:20px;text-align:center;">No students yet.</div>'; }
    }).getMyStudents();
    return;
  }

  // Render dropdown + content area; auto-load the first student
  var sO = stuList.map(function(s){
    return '<option value="' + esc(s.email) + '">' + esc(s.name) + '</option>';
  }).join('');
  el.innerHTML = '<select class="fsel" id="tvw-sel" onchange="loadTViewInline()" style="margin-bottom:10px;">' + sO + '</select>'
    + '<div id="tvw-content"><div style="color:var(--tx3);font-size:12px;padding:20px;text-align:center;">Pick a student to view their planner data.</div></div>';
  document.getElementById('tvw-sel').value = stuList[0].email;
  loadTViewInline();
}

// Groups widget — two tabs: Groups (list) and New/Edit Group (inline editor
// with a searchable student picker). Replaces the old modal flow.
function renderTGroupsWidget(){
  var el = document.getElementById('tw-tgrp');
  if (!el) return;

  el.style.display = 'flex';
  el.style.flexDirection = 'column';
  el.style.minHeight = '0';

  var tabBar = uiTabBar([
    {id:'list', label:'Groups', badge: groups.length || ''},
    {id:'edit', label: _grpEditName ? 'Edit Group' : 'New Group'}
  ], _tGrpTab, 'tGrpTab');

  if (_tGrpTab === 'edit'){
    el.innerHTML = tabBar + '<div id="grp-edit-wrap" style="flex:1;min-height:0;overflow-y:auto;padding-right:2px;"></div>';
    renderGrpEditor();
    return;
  }

  var studentCount = students.length;
  var groupRows = groups.map(function(g){
    return '<div style="background:rgba(15,23,42,.6);border:1px solid var(--border);border-radius:8px;padding:8px 10px;margin-bottom:5px;">'
      + '<div style="font-size:12px;font-weight:600;margin-bottom:2px;">' + esc(g.name) + '</div>'
      + '<div style="font-size:10px;color:var(--tx4);margin-bottom:7px;">' + g.emails.length + ' student' + (g.emails.length !== 1 ? 's' : '') + '</div>'
      + '<div style="display:flex;gap:6px;">'
      +   '<button onclick="tGrpEdit(\'' + esc(g.name) + '\')" style="flex:1;padding:5px 8px;background:#475569;color:#fff;border:none;border-radius:6px;font-size:11px;font-weight:600;cursor:pointer;font-family:inherit;">Edit</button>'
      +   '<button onclick="doDelGroup(\'' + esc(g.name) + '\')" style="flex:1;padding:5px 8px;background:#dc2626;color:#fff;border:none;border-radius:6px;font-size:11px;font-weight:600;cursor:pointer;font-family:inherit;">Delete</button>'
      + '</div></div>';
  }).join('') || '<div style="color:var(--tx4);font-size:12px;padding:14px;text-align:center;">No groups yet. Use the New Group tab.</div>';

  el.innerHTML = tabBar
    + '<div style="font-size:11px;color:var(--tx3);margin-bottom:8px;flex-shrink:0;"><strong style="color:var(--tx);">' + studentCount + '</strong> student' + (studentCount !== 1 ? 's' : '') + ' &middot; <strong style="color:var(--tx);">' + groups.length + '</strong> group' + (groups.length !== 1 ? 's' : '') + '</div>'
    + '<div style="flex:1;min-height:0;overflow-y:auto;padding-right:2px;">' + groupRows + '</div>';
}
// ── ROW PICKER ──────────────────────────────────────────────────
// Randomly draws from students you've personally given a ROW to —
// either by approving their request or awarding one directly.

// Grade from the graduation year in the email (jdoe32@ = class of 2032),
// with the school year flipping in August.
function _pickGradeOf(email){
  var m = String(email || '').split('@')[0].match(/(\d{2})$/);
  if (!m) return null;
  var gradYear = 2000 + parseInt(m[1], 10);
  var now = new Date();
  var yearEnd = now.getMonth() >= 7 ? now.getFullYear() + 1 : now.getFullYear();
  var grade = 12 - (gradYear - yearEnd);
  return (grade >= 1 && grade <= 12) ? grade : null;
}

function renderTPickWidget(){
  var el = document.getElementById('tw-tpick');
  if (!el) return;
  el.style.display = 'flex';
  el.style.flexDirection = 'column';
  el.style.minHeight = '0';

  var tabBar = uiTabBar([
    {id:'draw',  label:'Draw'},
    {id:'drawn', label:'Drawn'}
  ], _tPickTab, 'tPickTab');

  if (_tPickTab === 'drawn'){
    el.innerHTML = tabBar + '<div id="tpick-drawn" style="flex:1;min-height:0;overflow-y:auto;padding-right:2px;"></div>';
    renderTPickDrawn();
    return;
  }

  function gBtn(v, lbl){
    var on = _tPickGrade === v;
    return '<div onclick="tPickGrade(\'' + v + '\')" style="flex:1;text-align:center;padding:6px 4px;border-radius:7px;cursor:pointer;font-size:11px;font-weight:600;border:1px solid ' + (on ? 'var(--a1)' : 'var(--border)') + ';background:' + (on ? 'var(--a3)' : 'transparent') + ';color:' + (on ? 'var(--a2)' : 'var(--tx3)') + ';">' + lbl + '</div>';
  }

  el.innerHTML = tabBar
    + '<div style="display:flex;gap:5px;margin-bottom:10px;flex-shrink:0;">'
    +   gBtn('all','All') + gBtn('6','6th') + gBtn('7','7th') + gBtn('8','8th')
    + '</div>'
    + '<div id="tpick-result" style="flex:1;min-height:0;overflow-y:auto;display:flex;align-items:center;justify-content:center;text-align:center;"></div>'
    + '<div id="tpick-count" style="font-size:10px;color:var(--tx4);text-align:center;margin-bottom:6px;flex-shrink:0;"></div>'
    + '<button id="tpick-btn" onclick="tPickDraw()" style="width:100%;padding:9px 10px;background:#4f46e5;color:#fff;border:none;border-radius:7px;font-size:13px;font-weight:700;cursor:pointer;font-family:inherit;flex-shrink:0;">Pick a Student</button>';

  renderTPickResult();
  tPickLoadPool();
}

function tPickTab(t){ _tPickTab = t; renderTPickWidget(); }
function tPickGrade(g){ _tPickGrade = g; _tPickResult = null; renderTPickWidget(); }

// Pull every ROW transaction, keep the ones tied to this teacher.
function tPickLoadPool(force){
  if (_tPickPool && !force){ tPickRenderCount(); return; }
  var cnt = document.getElementById('tpick-count');
  if (cnt) cnt.textContent = 'Loading eligible students...';

  google.script.run.withSuccessHandler(function(r){
    var seen = {};
    ((r && r.transactions) || []).forEach(function(t){
      if (t.teacherEmail !== CU.email) return;
      var counts = (t.type === 'award') || (t.type === 'request' && t.status === 'approved');
      if (!counts) return;
      if (!seen[t.studentEmail]) seen[t.studentEmail] = t.studentName || t.studentEmail;
    });
    _tPickPool = Object.keys(seen).map(function(e){
      return {email:e, name:seen[e], grade:_pickGradeOf(e)};
    });
    tPickRenderCount();
  }).withFailureHandler(function(){
    var c = document.getElementById('tpick-count');
    if (c) c.textContent = 'Could not load students.';
  }).adminGetAllRowTransactions(0);
}

// Eligible = in the pool, matching grade, not already drawn.
function tPickEligible(){
  var drawn = (prefs.rowPickHistory || []).map(function(d){ return d.email; });
  return (_tPickPool || []).filter(function(s){
    if (drawn.indexOf(s.email) > -1) return false;
    if (_tPickGrade === 'all') return true;
    return String(s.grade) === _tPickGrade;
  });
}

function tPickRenderCount(){
  var el = document.getElementById('tpick-count');
  if (!el) return;
  if (!_tPickPool){ el.textContent = ''; return; }
  var n = tPickEligible().length;
  var drawn = (prefs.rowPickHistory || []).length;
  el.textContent = n + ' eligible' + (drawn ? ' \u00b7 ' + drawn + ' already drawn' : '');
}

function renderTPickResult(){
  var el = document.getElementById('tpick-result');
  if (!el) return;
  if (!_tPickResult){
    el.innerHTML = '<div style="color:var(--tx4);font-size:12px;padding:16px;">Students you\'ve given a ROW to are eligible.</div>';
    return;
  }
  var g = _tPickResult.grade ? _tPickResult.grade + 'th grade' : '';
  el.innerHTML = '<div>'
