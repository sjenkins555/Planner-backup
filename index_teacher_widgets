    return;
  }
  var pick = pool[Math.floor(Math.random() * pool.length)];
  _tPickResult = pick;

  if (!prefs.rowPickHistory) prefs.rowPickHistory = [];
  prefs.rowPickHistory.unshift({email:pick.email, name:pick.name, grade:pick.grade, at:new Date().toISOString()});
  google.script.run.saveMyPrefs(JSON.stringify(prefs));

  renderTPickResult();
  tPickRenderCount();
}

// Drawn list, split into grade sections. Anyone whose email doesn't
// encode a readable grad year lands in "Other".
function renderTPickDrawn(){
  var el = document.getElementById('tpick-drawn');
  if (!el) return;
  var hist = prefs.rowPickHistory || [];
  if (!hist.length){
    el.innerHTML = '<div style="color:var(--tx4);font-size:12px;padding:16px;text-align:center;">Nobody drawn yet.</div>';
    return;
  }

  // Keep original indexes so the X button still removes the right entry
  var buckets = {'6':[], '7':[], '8':[], 'other':[]};
  hist.forEach(function(d, i){
    var key = (d.grade === 6 || d.grade === 7 || d.grade === 8) ? String(d.grade) : 'other';
    buckets[key].push({d:d, i:i});
  });

  function row(item){
    var d = item.d;
    var when = '';
    try { when = (typeof fmtDate === 'function') ? fmtDate(d.at.slice(0,10)) : ''; } catch(e){}
    return '<div style="display:flex;align-items:center;gap:8px;background:rgba(255,255,255,.06);border:1px solid var(--border);border-radius:7px;padding:6px 9px;margin-bottom:4px;">'
      + '<div style="flex:1;min-width:0;">'
      +   '<div style="font-size:12px;font-weight:600;color:var(--tx);">' + esc(d.name) + '</div>'
      +   '<div style="font-size:10px;color:var(--tx2);">' + esc(String(d.email).split('@')[0]) + (when ? ' \u00b7 ' + when : '') + '</div>'
      + '</div>'
      + '<button onclick="tPickRemove(' + item.i + ')" title="Put back in the pool" style="padding:3px 9px;background:#dc2626;color:#fff;border:none;border-radius:5px;font-size:12px;font-weight:700;cursor:pointer;font-family:inherit;">\u2715</button>'
      + '</div>';
  }

  function section(key, label){
    var items = buckets[key];
    if (!items.length) return '';
    return '<div style="font-size:10px;font-weight:700;color:var(--a2);letter-spacing:.5px;text-transform:uppercase;margin:10px 2px 5px;padding-bottom:3px;border-bottom:1px solid var(--border);">'
      + label + ' <span style="color:var(--tx3);font-weight:600;">(' + items.length + ')</span></div>'
      + items.map(row).join('');
  }

  el.innerHTML =
      '<div style="font-size:11px;color:var(--tx3);margin-bottom:2px;"><strong style="color:var(--tx2);">' + hist.length + '</strong> drawn total</div>'
    + section('6', '6th Grade')
    + section('7', '7th Grade')
    + section('8', '8th Grade')
    + section('other', 'Other')
    + '<button onclick="tPickReset()" style="width:100%;margin-top:10px;padding:7px 10px;background:transparent;color:#f87171;border:1px solid rgba(239,68,68,.4);border-radius:7px;font-size:12px;font-weight:600;cursor:pointer;font-family:inherit;">Reset list</button>';
}

function tPickRemove(i){
  if (!prefs.rowPickHistory) return;
  prefs.rowPickHistory.splice(i, 1);
  google.script.run.saveMyPrefs(JSON.stringify(prefs));
