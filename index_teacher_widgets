// Submit the assign-link form. Auto-prefixes URL with https:// if missing.
function twLinkAssign(){
  var label = (document.getElementById('twl-label').value || '').trim();
  var url   = (document.getElementById('twl-url').value   || '').trim();
  var icon  = (document.getElementById('twl-icon').value  || '').trim();
  if (!label || !url){ toast('Label and URL required', 'err'); return; }
  if (!url.startsWith('http')) url = 'https://' + url;

  // Resolve target value (group name or student email)
  var tv = '';
  if (_twLinkTarget === 'group'){ var gs = document.getElementById('twla-gs'); tv = gs ? gs.value : ''; }
  else if (_twLinkTarget === 'individual'){ var ss = document.getElementById('twla-ss'); tv = ss ? ss.value : ''; }

  google.script.run.withSuccessHandler(function(r){
    if (r.success){
      toast('Link assigned', 'ok');
      document.getElementById('twl-label').value = '';
      document.getElementById('twl-url').value   = '';
      document.getElementById('twl-icon').value  = '';
    } else toast(r.error || 'Error', 'err');
  }).assignLinkToTarget(_twLinkTarget, tv, label, url, icon);
}

// Load and render the list of links the teacher has previously assigned.
function twLoadLinkList(){
  google.script.run.withSuccessHandler(function(r){
    var el = document.getElementById('twl-list');
    if (!el) return;
    if (!r.success || !r.links || !r.links.length){
      el.innerHTML = '<div style="color:var(--tx4);font-size:12px;padding:12px;text-align:center;">No links assigned yet.</div>';
      return;
    }
    el.innerHTML = r.links.map(function(l){
      // Friendly target label: "All", or the student's email-local-part if it's an individual
      var lbl = l.assignedTo === 'all' ? 'All' : (l.assignedTo.indexOf('@') > -1 ? l.assignedTo.split('@')[0] : l.assignedTo);
      return '<div style="display:flex;align-items:center;gap:6px;background:rgba(15,23,42,.6);border:1px solid var(--border);border-radius:7px;padding:5px 8px;margin-bottom:4px;font-size:12px;">'
        + '<div style="flex:1;min-width:0;"><div style="font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">' + esc(l.label) + '</div>'
        + '<div style="font-size:10px;color:var(--tx4);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">' + esc(lbl) + ' &middot; ' + esc(l.url) + '</div></div>'
        + '<button class="btn btn-danger btn-sm" onclick="twRemoveLink(\'' + esc(l.id) + '\')" style="padding:2px 6px;"><svg class="ui-ic-sm" viewBox="0 0 16 16"><use href="#w-x"/></svg></button>'
        + '</div>';
    }).join('');
  }).getTeacherAssignedLinks();
}

// Remove a previously-assigned link and reload the list.
function twRemoveLink(id){
  google.script.run.withSuccessHandler(function(r){
    if (r.success){ twLoadLinkList(); toast('Removed', 'inf'); }
  }).removeAssignedLink(id);
}


