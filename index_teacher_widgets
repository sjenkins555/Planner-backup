// Hide non-matching rows; checkmarks on hidden rows stay checked.
function grpFilter(){
  var q = ((document.getElementById('grp-search') || {}).value || '').trim().toLowerCase();
  var rows = document.querySelectorAll('#grp-rows label');
  for (var i = 0; i < rows.length; i++){
    var hit = !q || (rows[i].dataset.name || '').indexOf(q) > -1 || (rows[i].dataset.email || '').indexOf(q) > -1;
    rows[i].style.display = hit ? 'flex' : 'none';
  }
  grpUpdateCount();
}

function grpSelectVisible(on){
  var rows = document.querySelectorAll('#grp-rows label');
  for (var i = 0; i < rows.length; i++){
    if (rows[i].style.display === 'none') continue;
    var cb = rows[i].querySelector('input[type=checkbox]');
    if (cb) cb.checked = !!on;
  }
  grpUpdateCount();
}

function grpUpdateCount(){
  var el = document.getElementById('grp-count');
  if (!el) return;
  var all = document.querySelectorAll('#grp-rows label');
  var sel = document.querySelectorAll('#grp-rows input[type=checkbox]:checked').length;
  var shown = 0;
  for (var i = 0; i < all.length; i++){ if (all[i].style.display !== 'none') shown++; }
  el.innerHTML = '<strong style="color:var(--tx2);">' + sel + '</strong> selected'
    + (shown !== all.length ? ' &middot; showing ' + shown + ' of ' + all.length : '');
}

// Save from the inline editor. Hidden-but-checked rows are included, so a
// teacher can search, check a few, search again, check more, then save.
function saveGrpInline(){
  var msg = document.getElementById('grp-msg');
  var btn = document.getElementById('grp-save-btn');
  msg.style.color = '#f87171';

  var name = _grpEditName || ((document.getElementById('grp-name') || {}).value || '').trim();
  if (!name){ msg.textContent = 'Enter a group name.'; return; }

  var checked = Array.prototype.slice.call(document.querySelectorAll('#grp-rows input[type=checkbox]:checked'))
    .map(function(i){ return i.value; });
  if (!checked.length){ msg.textContent = 'Pick at least one student.'; return; }

  btn.disabled = true;
  btn.textContent = 'Saving...';

  google.script.run.withSuccessHandler(function(r){
    btn.disabled = false;
    btn.textContent = _grpEditName ? 'Save Changes' : 'Create Group';
    if (r && r.success){
      toast('Group saved', 'ok');
      _grpEditName = '';
      _tGrpTab = 'list';
      students = []; groups = [];
      loadStuGroups(function(){
        renderTGroupsWidget();
        // Refresh every dropdown that lists groups, so a new group is
        // immediately usable without reloading the page.
        if (typeof twRenderPTDet    === 'function') twRenderPTDet();
        if (typeof twLinkRenderDet  === 'function') twLinkRenderDet();
        if (typeof twRemRenderDet   === 'function') twRemRenderDet();
        if (typeof twEdRenderDet    === 'function') twEdRenderDet();
        if (typeof aEdRenderDet     === 'function') aEdRenderDet();
      });
    } else {
      msg.style.color = '#f87171';
      msg.textContent = (r && r.error) || 'Could not save group.';
    }
  }).withFailureHandler(function(e){
    btn.disabled = false;
    btn.textContent = _grpEditName ? 'Save Changes' : 'Create Group';
    msg.style.color = '#f87171';
    msg.textContent = (e && e.message) || 'Server error.';
  }).saveGroup(name, checked);
}

