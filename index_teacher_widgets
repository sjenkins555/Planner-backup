// Live URL detection — show a "Google Doc detected" / "Google Sheet detected"
// badge below the URL input as the user types. Uses detectDocType (other chunk).
function twEdDetect(){
  var url   = (document.getElementById('twed-url').value || '').trim();
  var badge = document.getElementById('twed-type-badge');
  if (!badge) return;
  var type = detectDocType(url);
  var labels = {doc:'Google Doc detected', sheet:'Google Sheet detected', slides:'Google Slides detected', form:'Google Form detected'};
  badge.textContent = url ? (labels[type] || 'Document') : '';
}

// Submit the embed form. Uses CU.email when target is 'self'.
function twEdCreate(){
  var title = (document.getElementById('twed-title').value || '').trim();
  var url   = (document.getElementById('twed-url').value   || '').trim();
  if (!title || !url){ toast('Title and URL required', 'err'); return; }

  var docType = detectDocType(url);

  // Resolve target value — group name, student email, or self (CU.email)
  var tv = '';
  if (_twEdTarget === 'group'){ var gs = document.getElementById('tweda-gs'); tv = gs ? gs.value : ''; }
  else if (_twEdTarget === 'individual'){ var ss = document.getElementById('tweda-ss'); tv = ss ? ss.value : ''; }
  else if (_twEdTarget === 'self') tv = CU.email;

  google.script.run.withSuccessHandler(function(r){
    if (r.success){
      toast('Embedded', 'ok');
      document.getElementById('twed-title').value = '';
      document.getElementById('twed-url').value   = '';
      document.getElementById('twed-type-badge').textContent = '';
    } else toast(r.error || 'Error', 'err');
  }).createEmbeddedDoc(title, url, docType, _twEdTarget, tv);
}

// Load and render the list of currently embedded documents.
function twEdLoadList(){
  google.script.run.withSuccessHandler(function(r){
    var el = document.getElementById('twed-list');
    if (!el) return;
    if (!r.success || !r.docs || !r.docs.length){
      el.innerHTML = '<div style="color:var(--tx4);font-size:12px;padding:12px;text-align:center;">No embedded documents yet.</div>';
      return;
    }
    el.innerHTML = r.docs.map(function(d){
      var lbl = d.assignedTo === 'all' ? 'All' : (d.assignedTo.indexOf('@') > -1 ? d.assignedTo.split('@')[0] : d.assignedTo);
      return '<div style="display:flex;align-items:center;gap:6px;background:rgba(15,23,42,.6);border:1px solid var(--border);border-radius:7px;padding:5px 8px;margin-bottom:4px;font-size:12px;">'
        + '<div style="flex:1;min-width:0;"><div style="font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">' + esc(d.title) + '</div>'
        + '<div style="font-size:10px;color:var(--tx4);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">' + esc(d.docType) + ' &middot; ' + esc(lbl) + '</div></div>'
        + '<button class="btn btn-danger btn-sm" onclick="twEdDel(\'' + esc(d.id) + '\')" style="padding:2px 6px;"><svg class="ui-ic-sm" viewBox="0 0 16 16"><use href="#w-x"/></svg></button>'
        + '</div>';
    }).join('');
  }).getTeacherEmbeddedDocs();
}

// Delete an embedded doc and reload the list.
function twEdDel(id){
  google.script.run.withSuccessHandler(function(r){
    if (r.success){ twEdLoadList(); toast('Removed', 'inf'); }
  }).deleteEmbeddedDoc(id);
}


/* ═══════════════════════════════════════════════════════════════════
   9. SEND REMINDER WIDGET — handlers
   ═══════════════════════════════════════════════════════════════════ */

// Set the Send Reminder target and update the visual selected state.
function twRemSetTarget(t){
  _twRemTarget = t;
  ['all','group','ind'].forEach(function(x){
    var el = document.getElementById('trem-' + x);
    if (el) el.classList.remove('sel');
  });
  var key = t === 'individual' ? 'ind' : t;
  var el = document.getElementById('trem-' + key);
  if (el) el.classList.add('sel');
  twRemRenderDet();
}

// Render the per-target detail UI for Send Reminder.
function twRemRenderDet(){
  var el = document.getElementById('trem-det');
  if (!el) return;

  if (_twRemTarget === 'all'){
    el.innerHTML = '<div style="font-size:11px;color:var(--tx3);background:var(--bg3);border:1px solid var(--border);border-radius:6px;padding:6px 10px;">Sends to all ' + students.length + ' student(s)</div>';
    return;
  }
  if (_twRemTarget === 'group'){
    var gO = groups.map(function(g){ return '<option value="' + esc(g.name) + '">' + esc(g.name) + ' (' + g.emails.length + ')</option>'; }).join('');
    el.innerHTML = gO ? '<select class="fsel" id="trem-gs">' + gO + '</select>' : '<div style="color:var(--tx3);font-size:11px;">No groups yet.</div>';
    return;
  }
  var sO = students.map(function(s){ return '<option value="' + esc(s.email) + '">' + esc(s.name) + '</option>'; }).join('');
  el.innerHTML = sO ? '<select class="fsel" id="trem-ss">' + sO + '</select>' : '<div style="color:var(--tx3);font-size:11px;">No students yet.</div>';
}

// Submit the reminder form. Empty datetime means "send now".
// Calls server's pushReminder; clears form fields on success.
function twSendReminder(){
  var title = (document.getElementById('trem-title') || {}).value || '';
  var body  = (document.getElementById('trem-body')  || {}).value || '';
  var when  = (document.getElementById('trem-when')  || {}).value || '';
  if (!title.trim()){ toast('Title required', 'err'); return; }

  // Resolve target value
  var tv = '';
  if (_twRemTarget === 'group'){ var gs = document.getElementById('trem-gs'); tv = gs ? gs.value : ''; }
  else if (_twRemTarget === 'individual'){ var ss = document.getElementById('trem-ss'); tv = ss ? ss.value : ''; }

  // Empty string ISO means immediate send
  var triggerISO = when ? new Date(when).toISOString() : '';

  google.script.run.withSuccessHandler(function(r){
    if (r && r.success){
      toast('Reminder sent', 'ok');
      document.getElementById('trem-title').value = '';
      document.getElementById('trem-body').value  = '';
      document.getElementById('trem-when').value  = '';
    } else toast((r && r.error) || 'Error', 'err');
  }).pushReminder(_twRemTarget, tv, title.trim(), body.trim(), triggerISO, '');
}


/* ═══════════════════════════════════════════════════════════════════
   10. GROUPS MODAL
   Used by the Groups widget. Modal IDs (group-modal, m-gn, gm-title,
   grp-list) are defined in Index.html's modal section.
   ═══════════════════════════════════════════════════════════════════ */

// Open the group editor modal. Pass a name to edit, omit to create new.
// Renders a checkbox per student, pre-checked if already in the group.
function openGrpModal(editName){
  // Find the existing group (if editing)
  var ex = editName ? (function(){
    for (var i = 0; i < groups.length; i++){
      if (groups[i].name === editName) return groups[i];
    }
    return {};
  })() : {};
  var emails = ex.emails || [];

  document.getElementById('m-gn').value    = editName || '';
  document.getElementById('m-gn').disabled = !!editName; // can't rename existing groups
  document.getElementById('gm-title').textContent = editName ? 'Edit "' + editName + '"' : 'New Group';

  var rows = students.map(function(s){
    return '<label data-name="' + esc(String(s.name || '').toLowerCase()) + '" data-email="' + esc(String(s.email || '').toLowerCase()) + '" '
      + 'style="display:flex;align-items:center;gap:8px;padding:7px 9px;border-radius:8px;cursor:pointer;background:var(--bg3);border:1px solid var(--border);margin-bottom:4px;">'
      + '<input type="checkbox" value="' + esc(s.email) + '" ' + (emails.indexOf(s.email) > -1 ? 'checked' : '') + ' onchange="grpUpdateCount()">'
      + '<span style="font-size:13px;font-weight:500;">' + esc(s.name) + '</span>'
      + '<span style="font-size:11px;color:var(--tx4);">' + esc(s.email) + '</span>'
      + '</label>';
  }).join('') || '<div style="color:var(--tx4);">No students yet.</div>';

  document.getElementById('grp-list').innerHTML =
      '<div style="position:sticky;top:0;background:var(--bg2);padding:0 0 7px;z-index:2;">'
    +   '<input class="finp" id="grp-search" placeholder="Search by name or email" oninput="grpFilter()" style="font-size:12px;margin-bottom:6px;">'
    +   '<div style="display:flex;align-items:center;gap:8px;">'
    +     '<div id="grp-count" style="flex:1;font-size:11px;color:var(--tx3);"></div>'
    +     '<button class="btn btn-ghost btn-sm" onclick="grpSelectVisible(true)" style="font-size:10px;padding:2px 7px;">Select shown</button>'
    +     '<button class="btn btn-ghost btn-sm" onclick="grpSelectVisible(false)" style="font-size:10px;padding:2px 7px;">Clear</button>'
    +   '</div>'
    + '</div>'
    + '<div id="grp-rows">' + rows + '</div>';

  grpUpdateCount();
  openModal('group-modal');
  var gs = document.getElementById('grp-search');
  if (gs) gs.focus();
}

// Hide non-matching rows. Hiding (rather than re-rendering) keeps
// checkmarks intact while the teacher types.
function grpFilter(){
  var q = ((document.getElementById('grp-search') || {}).value || '').trim().toLowerCase();
  var rows = document.querySelectorAll('#grp-rows label');
  for (var i = 0; i < rows.length; i++){
    var hit = !q
      || (rows[i].dataset.name  || '').indexOf(q) > -1
      || (rows[i].dataset.email || '').indexOf(q) > -1;
    rows[i].style.display = hit ? 'flex' : 'none';
  }
  grpUpdateCount();
}

// Check or uncheck every currently-visible row.
function grpSelectVisible(on){
  var rows = document.querySelectorAll('#grp-rows label');
  for (var i = 0; i < rows.length; i++){
    if (rows[i].style.display === 'none') continue;
    var cb = rows[i].querySelector('input[type=checkbox]');
    if (cb) cb.checked = !!on;
  }
  grpUpdateCount();
}

// "N selected" readout, plus a count of what the filter is showing.
function grpUpdateCount(){
  var el = document.getElementById('grp-count');
  if (!el) return;
  var all = document.querySelectorAll('#grp-rows label');
  var sel = document.querySelectorAll('#grp-rows input[type=checkbox]:checked').length;
  var shown = 0;
  for (var i = 0; i < all.length; i++){ if (all[i].style.display !== 'none') shown++; }
  el.innerHTML = '<strong style="color:var(--tx2);">' + sel + '</strong> selected'
    + (shown !== all.length ? ' &middot; showing ' + shown + ' of ' + all.length : '');
}

// Save the group from the modal (creates or updates) and refresh.
function doSaveGroup(){
  var name = document.getElementById('m-gn').value.trim();
  if (!name){ toast('Enter a name', 'err'); return; }

  var checked = Array.from(document.querySelectorAll('#grp-list input:checked')).map(function(i){ return i.value; });
  closeModal('group-modal');

  google.script.run.withSuccessHandler(function(r){
    if (r.success){
      toast('Group saved', 'ok');
      // Force re-fetch on next render so new group shows up everywhere
      students = []; groups = [];
      buildGroupsPage();
    }
  }).saveGroup(name, JSON.stringify(checked));
}

// Confirm and delete a group, then refresh.
function doDelGroup(name){
  if (!confirm('Delete group "' + name + '"?')) return;
  google.script.run.withSuccessHandler(function(r){
    if (r && r.success){
      toast('Deleted', 'inf');
      students = []; groups = [];
      _grpEditName = '';
      _tGrpTab = 'list';
      students = []; groups = [];
      loadStuGroups(function(){
        renderTGroupsWidget();
        // Refresh every dropdown that lists groups, so a new group is
        // immediately usable without reloading the page.
        if (typeof twRenderPTDet    === 'function') twRenderPTDet();
        if (typeof twLinkRenderDet  === 'function') twLinkRenderDet();
        if (typeof twRemRenderDet   === 'function') twRemRenderDet();
        if (typeof twEdRenderDet    === 'function') twEdRenderDet();
        if (typeof aEdRenderDet     === 'function') aEdRenderDet();
      });
    } else toast((r && r.error) || 'Could not delete', 'err');
  }).deleteGroup(name);
}


/* ═══════════════════════════════════════════════════════════════════
   11. LEGACY PUSH PAGE
   Older standalone push UI using element IDs `to-*` / `pt-det` / `p-tt`
   etc. These are NOT used by the modern Push Tasks widget (which uses
   `twp-*` / `tp-*`). Kept verbatim per refactor rules — likely dead code
   but flagging here so a future pass can verify and remove.
   ═══════════════════════════════════════════════════════════════════ */

// Legacy: set push target on the older standalone push page.
function setPT(t){
  pushTarget = t;
  ['all','group','ind'].forEach(function(x){
    var b = document.getElementById('to-' + x);
    if (b) b.classList.remove('sel');
  });
  var k = t === 'individual' ? 'ind' : t;
  var b = document.getElementById('to-' + k);
  if (b) b.classList.add('sel');

  var g = groups.map(function(g){ return '<option value="' + esc(g.name) + '">' + esc(g.name) + ' (' + g.emails.length + ')</option>'; }).join('');
  var s = students.map(function(s){ return '<option value="' + esc(s.email) + '">' + esc(s.name) + '</option>'; }).join('');
  renderPTDet(g, s);
}

// Legacy: render push target detail row (group/student dropdown).
function renderPTDet(g, s){
  var el = document.getElementById('pt-det');
  if (!el) return;
  if (pushTarget === 'all') el.innerHTML = '<div style="font-size:12px;color:var(--tx3);background:var(--bg3);border:1px solid var(--border);border-radius:10px;padding:9px 12px;">Sends to all ' + students.length + ' registered student(s)</div>';
  else if (pushTarget === 'group') el.innerHTML = g ? '<select class="fsel" id="p-gs">' + g + '</select>' : '<div style="color:var(--tx3);font-size:12px;">No groups yet.</div>';
  else el.innerHTML = s ? '<select class="fsel" id="p-ss">' + s + '</select>' : '<div style="color:var(--tx3);font-size:12px;">No students yet.</div>';
}

// Legacy: submit the older push form via pushAssignment.
function doPush(){
  var title = document.getElementById('p-tt').value.trim();
  if (!title){ toast('Enter a title', 'err'); return; }

  var tv = '';
  if (pushTarget === 'group'){
    var sg = document.getElementById('p-gs');
    tv = sg ? sg.value : '';
    if (!tv){ toast('Select a group', 'err'); return; }
  }
  if (pushTarget === 'individual'){
    var ss = document.getElementById('p-ss');
    tv = ss ? ss.value : '';
    if (!tv){ toast('Select a student', 'err'); return; }
  }

  google.script.run.withSuccessHandler(function(r){
    if (r.success){
      toast('Pushed to ' + r.count + ' student(s)!', 'ok');
      document.getElementById('p-tt').value = '';
      document.getElementById('p-tn').value = '';
      document.getElementById('p-td').value = '';
    } else toast(r.error || 'Error', 'err');
  }).pushAssignment(
    document.getElementById('p-tt').value.trim(),
    document.getElementById('p-ts').value.trim(),
    document.getElementById('p-td').value,
    document.getElementById('p-tp').value,
    document.getElementById('p-tn').value.trim(),
    pushTarget,
    tv
  );
}


/* ═══════════════════════════════════════════════════════════════════
   12. HELPERS
   ═══════════════════════════════════════════════════════════════════ */

// Pre-fetch students + groups for the teacher tab. Skips the round-trip
// if either global is already populated. Falls back to two sequential
// calls if the combined endpoint fails.
function loadStuGroups(cb){
  if (students.length || groups.length){ cb(); return; }

  google.script.run.withSuccessHandler(function(r){
    students = (r && r.students) || [];
    groups   = (r && r.groups)   || [];
    cb();
  }).withFailureHandler(function(){
    // Fallback path: two separate calls
    google.script.run.withSuccessHandler(function(sl){
      students = sl || [];
      google.script.run.withSuccessHandler(function(gl){
        groups = gl || [];
        cb();
      }).getGroups();
    }).getStudentList();
  }).getStuGroupData();
}

